  .nav-item.active svg{color:#0A0A0A;}
  .qa-btn{transition:transform .2s ease, box-shadow .2s ease;}
  .qa-btn:hover{transform:translateY(-2px) scale(1.03);}
  .fade-up{opacity:0;transform:translateY(16px);animation:fadeUp .5s ease forwards;}
  @keyframes fadeUp{to{opacity:1;transform:translateY(0);}}
