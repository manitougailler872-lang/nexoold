<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>NexoBanque — La banque en ligne simple, rapide et sécurisée</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link rel="icon" type="image/png" href="{{asset('assets/images/favicon.png')}}">
       <script>
            tailwind.config = { theme:{ extend:{
                colors:{ green:'#2E9E5B','green-deep':'#24824A', nexo: '#86D3A6',mint:'#EAF6EF','mint-2':'#F3F9F5', ink:'#1A1D1F', gray50:'#F5F6F7', muted:'#6B7280' },
                fontFamily:{ sans:['Space Grotesk','sans-serif'], head:['Space Grotesk','sans-serif'] }
            }}}
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">

        <style>
            html,body,input,button{ font-family:'Space Grotesk',sans-serif; }
            body{ background:#fff; color:#1A1D1F; }
            .font-head{ font-family:'Space Grotesk',sans-serif; }
            ::selection{ background:#2E9E5B; color:#fff; }
            a:focus-visible,button:focus-visible{ outline:2px solid #2E9E5B; outline-offset:2px; }
        </style>
            <style>
  ::-webkit-scrollbar{width:8px;height:8px;} ::-webkit-scrollbar-thumb{background:#E8EAF0;border-radius:100px;}
  .nav-item{transition:background-color .22s ease, color .22s ease;}
  .nav-item.active{background:#EFF6FF;color:#0A0A0A;}
  .nav-item.active svg{color:#0A0A0A;}
  .qa-btn{transition:transform .2s ease, box-shadow .2s ease;}
  .qa-btn:hover{transform:translateY(-2px) scale(1.03);}
  .fade-up{opacity:0;transform:translateY(16px);animation:fadeUp .5s ease forwards;}
  @keyframes fadeUp{to{opacity:1;transform:translateY(0);}}
  .skel{background:linear-gradient(90deg,#EEF1F5 25%,#E4E8EE 37%,#EEF1F5 63%);background-size:400% 100%;animation:skel 1.4s ease infinite;border-radius:8px;}
  @keyframes skel{0%{background-position:100% 50%;}100%{background-position:0 50%;}}
  @media (prefers-reduced-motion: reduce){ .fade-up{animation:none;opacity:1;transform:none;} .skel{animation:none;} }
  #sidebarNav{transition:transform .3s ease;}
  .toast{animation:toastIn .3s ease;}
  @keyframes toastIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
</style>
        <style>
  :root{
    --ink:#0F1A16;
    --ink-2:#3D4B45;
    --ink-3:#6B7A73;
    --green-900:#0C2B21;
    --green-800:#113E2F;
    --green-700:#14523C;
    --green-600:#1A7F5A;
    --green-500:#16A34A;
    --mint:#22C55E;
    --red:#E5484D;
    --amber:#B45309;
    --line:#E3E8E5;
    --surface:#FFFFFF;
    --surface-2:#F7FAF8;
  }
  *{box-sizing:border-box}
  body{
    font-family:'Space Grotesk',system-ui,sans-serif;
    color:var(--ink);
    background:var(--surface);
    -webkit-font-smoothing:antialiased;
  }
  .num{font-variant-numeric:tabular-nums;letter-spacing:.04em;font-weight:700}
  .eyebrow{font-size:11px;letter-spacing:.13em;text-transform:uppercase;font-weight:700;color:var(--ink-3)}
  .cell-h{font-size:11px;letter-spacing:.09em;text-transform:uppercase;font-weight:700}
  .link-underline{position:relative}
  .link-underline::after{content:"";position:absolute;left:0;bottom:-3px;height:2px;width:0;background:var(--green-600);transition:width .25s ease}
  .link-underline:hover::after{width:100%}
  .row-hover:hover{background:var(--surface-2)}
  .card-hover{transition:border-color .2s ease, transform .2s ease, box-shadow .2s ease}
  .card-hover:hover{border-color:#B9CFC5;transform:translateY(-2px);box-shadow:0 12px 30px -18px rgba(12,43,33,.45)}
  .card-hover:hover .arrow{transform:translateX(4px);color:var(--green-600)}
  .arrow{transition:transform .2s ease,color .2s ease}
  .tabbtn.active{background:var(--green-700);color:#fff}
  /* pastille de validation sur l'option sélectionnée */
  .peer:checked ~ div .check,
  .peer:checked + div .check{opacity:1}
  label:hover > div{border-color:#B9CFC5}
  .pulse-dot{animation:pulse 2s ease-in-out infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
  :focus-visible{outline:2px solid var(--green-600);outline-offset:2px}
</style>
    </head>
    <body class="antialiased">
       
        <!-- TOP BAR -->
        {% include 'shared/public/_top_bar.html.twig' %}

        <!-- HEADER -->
        {% include 'shared/public/_header.html.twig' %}

        <main class="max-w-[1240px]  mx-auto px-6">
                {% block body %}
                {% endblock %}
        </main>
        <!-- FOOTER -->
         {% include 'shared/public/_footer.html.twig' %}

        {% block javascripts %}
       
        {% endblock %}
        <script>
            // Révélation au scroll (respecte prefers-reduced-motion via le CSS)
            const revealEls = document.querySelectorAll(".reveal");
            if ("IntersectionObserver" in window) {
                const io = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("in-view");
                                io.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.15 }
                );
                revealEls.forEach((el) => io.observe(el));
            } else {
                revealEls.forEach((el) => el.classList.add("in-view"));
            }

            // Cartes crypto — données réelles CoinGecko (BTC, ETH, SOL)
            function sparkline(prices, color) {
                if (!prices || prices.length < 2) return "";
                const w = 260,
                    h = 50,
                    pad = 3;
                const min = Math.min(...prices),
                    max = Math.max(...prices);
                const range = max - min || 1;
                const step = (w - pad * 2) / (prices.length - 1);
                const pts = prices
                    .map((p, i) => {
                        const x = pad + i * step;
                        const y = pad + (h - pad * 2) * (1 - (p - min) / range);
                        return `${x.toFixed(1)},${y.toFixed(1)}`;
                    })
                    .join(" ");
                return `<svg viewBox="0 0 ${w} ${h}" class="w-full h-[46px]"><polyline points="${pts}" fill="none" stroke="${color}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
            }

            async function loadCryptoCards() {
                try {
                    const res = await fetch(
                        "https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids=bitcoin,ethereum,solana&order=market_cap_desc&sparkline=true&price_change_percentage=24h"
                    );
                    const data = await res.json();
                    const colors = { bitcoin: "#F7931A", ethereum: "#627EEA", solana: "#14F195" };
                    document.getElementById("cryptoCards").innerHTML = data
                        .map((c) => {
                            const up = c.price_change_percentage_24h >= 0;
                            const spark = c.sparkline_in_7d ? c.sparkline_in_7d.price.slice(-48) : [];
                            return `<div class="bg-surface border border-line rounded-2xl p-6 reveal in-view">
                                                <div class="flex items-center gap-3 mb-4">
                                                    <img src="${c.image}" class="w-9 h-9 rounded-full" alt="${c.name}">
                                                    <div><div class="font-semibold">${c.name}</div><div class="text-muted text-xs uppercase">${c.symbol}</div></div>
                                                </div>
                                                <div class="flex items-baseline justify-between mb-3">
                                                    <span class="text-2xl font-bold font-mono">$${c.current_price.toLocaleString("en-US")}</span>
                                                    <span class="font-mono text-[13.5px] ${up ? "text-up" : "text-down"}">${up ? "+" : ""}${(c.price_change_percentage_24h || 0).toFixed(2)}%</span>
                                                </div>
                                                ${sparkline(spark, colors[c.id] || "#1F8F5C")}
                                            </div>`;
                        }).join("");
                } catch (e) {
                    document.getElementById("cryptoCards").innerHTML =
                        '<div class="col-span-3 text-center text-muted text-sm py-8">Données de marché momentanément indisponibles.</div>';
                }
            }
            loadCryptoCards();
            setInterval(loadCryptoCards, 60000);
        </script>
    </body>
</html>
