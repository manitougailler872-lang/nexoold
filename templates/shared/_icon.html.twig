{#
    Jeu d'icônes SVG en ligne.

    Usage : {{ include('shared/_icon.html.twig', {name: 'wallet'}, with_context = false) }}
    Option : {name: 'wallet', class: 'w-5 h-5 text-nexo-600'}

    Les SVG sont inlinés plutôt que chargés depuis un sprite : elles héritent
    de currentColor, indispensable pour l'état actif de la navigation.
#}
{% set class = class|default('w-[18px] h-[18px] shrink-0') %}

<svg class="{{ class }}" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    {% if name == 'grid' %}
        <rect x="3.5" y="3.5" width="7" height="7" rx="1.8" stroke="currentColor" stroke-width="1.8"/>
        <rect x="13.5" y="3.5" width="7" height="7" rx="1.8" stroke="currentColor" stroke-width="1.8"/>
        <rect x="3.5" y="13.5" width="7" height="7" rx="1.8" stroke="currentColor" stroke-width="1.8"/>
        <rect x="13.5" y="13.5" width="7" height="7" rx="1.8" stroke="currentColor" stroke-width="1.8"/>

    {% elseif name == 'wallet' %}
        <rect x="3" y="6" width="18" height="13" rx="2.6" stroke="currentColor" stroke-width="1.8"/>
        <path d="M3 10h18" stroke="currentColor" stroke-width="1.8"/>

    {% elseif name == 'card' %}
        <rect x="3" y="5.5" width="18" height="13" rx="2.6" stroke="currentColor" stroke-width="1.8"/>
        <path d="M3 10h18M6.5 14.5h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>

    {% elseif name == 'exchange' %}
        <path d="M4 8h13l-3.2-3.2M20 16H7l3.2 3.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>

    {% elseif name == 'users' %}
        <circle cx="9.5" cy="8.5" r="3.2" stroke="currentColor" stroke-width="1.8"/>
        <path d="M3.8 19a5.7 5.7 0 0111.4 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M16.5 6.4a3 3 0 010 5.7M18 19a5 5 0 00-1.6-3.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>

    {% elseif name == 'book' %}
        <rect x="4.5" y="3.5" width="15" height="17" rx="2.4" stroke="currentColor" stroke-width="1.8"/>
        <path d="M9 3.5v8l3-2 3 2v-8" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>

    {% elseif name == 'trend' %}
        <path d="M3.5 17l5.5-5.5 3.5 3.5L20.5 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M15.5 7h5v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>

    {% elseif name == 'coin' %}
        <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="M12 7.5v9M9.8 9.8h3.6a1.6 1.6 0 010 3.2H9.8h4a1.6 1.6 0 010 3.2H9.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>

    {% elseif name == 'file' %}
        <path d="M13.8 3.5v4.7h4.7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        <path d="M18.5 8.8V19a1.8 1.8 0 01-1.8 1.8H7.3A1.8 1.8 0 015.5 19V5.3a1.8 1.8 0 011.8-1.8h6.5l4.7 5.3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>

    {% elseif name == 'file-check' %}
        <path d="M13.8 3.5v4.7h4.7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        <path d="M18.5 8.8V19a1.8 1.8 0 01-1.8 1.8H7.3A1.8 1.8 0 015.5 19V5.3a1.8 1.8 0 011.8-1.8h6.5l4.7 5.3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        <path d="M9.2 14.2l2 2 3.6-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>

    {% elseif name == 'gear' %}
        <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
        <path d="M12 3.5v2.2M12 18.3v2.2M20.5 12h-2.2M5.7 12H3.5M18 6l-1.6 1.6M7.6 16.4L6 18M18 18l-1.6-1.6M7.6 7.6L6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>

    {% elseif name == 'help' %}
        <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="M9.7 9.4a2.4 2.4 0 113.8 2.2c-.85.6-1.5 1-1.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <circle cx="12" cy="16.6" r="1" fill="currentColor"/>

    {% elseif name == 'bank' %}
        <path d="M3.8 9.5L12 4.5l8.2 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6 10.5v7M10 10.5v7M14 10.5v7M18 10.5v7M4 19.5h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>

    {% elseif name == 'user-plus' %}
        <circle cx="10" cy="8.5" r="3.4" stroke="currentColor" stroke-width="1.8"/>
        <path d="M4 19.5a6 6 0 0112 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M18.5 8v5M21 10.5h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>

    {% elseif name == 'download' %}
        <path d="M12 4v10m0 0l-3.6-3.6M12 14l3.6-3.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M4.5 17v1.5a2 2 0 002 2h11a2 2 0 002-2V17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>

    {% elseif name == 'shield' %}
        <path d="M12 3l7.2 3v6c0 4.5-3.1 8-7.2 9.2C7.9 20 4.8 16.5 4.8 12V6L12 3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        <path d="M9.2 12.2l2 2 3.6-3.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>

    {% elseif name == 'check-circle' %}
        <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="M8.6 12.3l2.4 2.4 4.4-4.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
   {% elseif name == 'goodnight' %}
      <path
    d="M20.5 14.5A8 8 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
/>   {% elseif name == 'goodmoney' %}
       <circle
    cx="12"
    cy="12"
    r="4"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
/>

<path
    d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
/>
    {% elseif name == 'arrow-right' %}
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>

    {% elseif name == 'arrow-down' %}
        <path d="M12 5v14M6 13l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>

    {% elseif name == 'eye' %}
        <path d="M2.8 12S6.5 5.8 12 5.8 21.2 12 21.2 12 17.5 18.2 12 18.2 2.8 12 2.8 12z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        <circle cx="12" cy="12" r="2.8" stroke="currentColor" stroke-width="1.8"/>

    {% elseif name == 'info' %}
        <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="M12 11v5.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <circle cx="12" cy="7.9" r="1" fill="currentColor"/>

    {% elseif name == 'search' %}
        <circle cx="11" cy="11" r="6.6" stroke="currentColor" stroke-width="1.8"/>
        <path d="M16 16l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>

    {% elseif name == 'mail' %}
        <rect x="3" y="5.5" width="18" height="13" rx="2.4" stroke="currentColor" stroke-width="1.8"/>
        <path d="M3.6 7l8.4 6 8.4-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>

    {% elseif name == 'bell' %}
        <path d="M6.5 10a5.5 5.5 0 1111 0v4l1.6 2.6H4.9L6.5 14v-4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        <path d="M10 19.5a2.2 2.2 0 004 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>

    {% elseif name == 'menu' %}
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>

    {% elseif name == 'dots' %}
        <circle cx="12" cy="5.5" r="1.6" fill="currentColor"/>
        <circle cx="12" cy="12" r="1.6" fill="currentColor"/>
        <circle cx="12" cy="18.5" r="1.6" fill="currentColor"/>
        
     {% elseif name == 'calendar' %}
       <rect
    x="3"
    y="5"
    width="18"
    height="16"
    rx="2"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
/>

<path
    d="M8 3v4M16 3v4M3 10h18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
/>

     {% elseif name == 'bolt' %}
        <path
    d="M13 2 4.5 13H11l-1 9L19.5 11H13V2Z"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
/>

     {% elseif name == 'chevron-left' %}
<path
    d="M15 18l-6-6 6-6"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
/>

    {% elseif name == 'cadenas' %}
       <path
    d="M7 10V7a5 5 0 0 1 10 0v3"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
/>
<rect
    x="5"
    y="10"
    width="14"
    height="11"
    rx="2"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
/>
<path
    d="M12 14v3"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
/>

    {% elseif name == 'warning' %}
        <path d="M12 4.5l8.5 15h-17l8.5-15z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        <path d="M12 10v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <circle cx="12" cy="16.8" r="1" fill="currentColor"/>
     {% elseif name == 'add' %}
        <path d="M12 5.5v13M5.5 12h13" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" />
    {% endif %}
</svg>
