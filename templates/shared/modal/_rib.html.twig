<!-- MODALE RETRAIT -->
<div
    id="ribOverlay"
    class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4"
>
    <div class="bg-surface rounded-2xl w-full max-w-[440px] p-7 shadow-2xl">
            <div class="mx-auto max-w-md">
                <!-- Header -->
                <div class="mb-5">
                    <div class="flex items-center justify-between">
                    <p class="mt-1 text-sm font-bold text-slate-900">Relevé d’Identité Bancaire</p>
                    <button
                            class="close-modal w-8 h-8 rounded-full hover:bg-surface2 flex items-center justify-center text-muted"
                            data-modal="ribOverlay"
                        >
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <path d="M6 6L18 18M6 18L18 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </button>
                   </div>
                    <p class="mt-1 text-xs text-slate-500">Utilisez ce relevé pour effectuer vos virements.</p>
                
                   </div>

                <!-- Carte RIB -->
                <section
                    class="overflow-hidden rounded-2xl border border-emerald-900/20 bg-gradient-to-br from-emerald-950 via-emerald-900 to-emerald-800 shadow-lg"
                >
                    <!-- Header carte -->
                    <div class="flex items-center justify-between px-5 py-4 text-white">
                        <div class="flex items-center gap-3">
                            <svg width="30" height="30" viewBox="0 0 32 32" fill="none">
                    <path
                        d="M16 3c2 4 6 6 10 6-2 4-2 9 0 13-4 0-8 2-10 6-2-4-6-6-10-6 2-4 2-9 0-13 4 0 8-2 10-6z"
                        fill="#16A34A"
                    />
                    <circle cx="16" cy="16" r="4" fill="#fff" />
                </svg>
                <span class="font-head font-bold text-xl tracking-tight"
                    >Nexo Banque</span></span
                >
                        </div>

                        <p class="text-[10px] font-bold uppercase tracking-wide text-white/80">
                            Relevé d’identité bancaire
                        </p>
                    </div>

                    <!-- Contenu blanc -->
                    <div class="mx-3 mb-3 rounded-xl bg-white p-4 shadow-sm">
                        <!-- Titulaire / domiciliation -->
                        <div class="grid grid-cols-2 gap-4 border-b border-slate-200 pb-4">
                            <div>
                                <p class="text-[10px] font-semibold text-slate-500">Titulaire du compte</p>
                                <p class="mt-1 text-sm font-bold text-slate-900">{{app.user.customer.firstname}}</p>
                            </div>

                            <div>
                                <p class="text-[10px] font-semibold text-slate-500">Domiciliation</p>
                                <p class="mt-1 text-sm font-bold text-slate-900">Nexo Banque</p>
                            </div>
                        </div>

                        <!-- IBAN -->
                        <div class="border-b border-slate-200 py-4">
                            <p class="text-[10px] font-semibold text-slate-500">IBAN</p>

                            <p class="mt-1 text-base font-extrabold tracking-[0.12em] text-emerald-700">
                                {{principalAccount.ibanFormatted}}
                            </p>
                        </div>

                        <!-- Détails bancaires -->
                        <div class="grid grid-cols-4 gap-3 border-b border-slate-200 py-4">
                            <div>
                                <p class="text-[9px] font-semibold leading-tight text-slate-500">Code banque</p>
                                <p class="mt-1 text-sm font-bold"> {{principalAccount.codeBanque}}</p>
                            </div>

                            <div>
                                <p class="text-[9px] font-semibold leading-tight text-slate-500">Code guichet</p>
                                <p class="mt-1 text-sm font-bold"> {{principalAccount.codeGuichet}}</p>
                            </div>

                            <div>
                                <p class="text-[9px] font-semibold leading-tight text-slate-500">Numéro Compte</p>
                                <p class="mt-1 text-sm font-bold"> {{principalAccount.accountNumber}}</p>
                            </div>

                            <div>
                                <p class="text-[9px] font-semibold leading-tight text-slate-500">Clé RIB</p>
                                <p class="mt-1 text-sm font-bold"> {{principalAccount.cleRib}}</p>
                            </div>
                        </div>

                        <!-- BIC -->
                        <div class="pt-4">
                            <p class="text-[10px] font-semibold text-slate-500">BIC / SWIFT</p>
                            <p class="mt-1 text-sm font-bold text-slate-900">NexoFRPP58X</p>
                        </div>
                    </div>
                </section>

                <!-- Important -->
                <div class="mt-4 flex gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-emerald-700">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-6 w-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.8"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z"
                            />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.5 12l1.7 1.7L15 10" />
                        </svg>
                    </div>

                    <div>
                        <p class="text-xs font-bold text-emerald-800">Important</p>

                        <p class="mt-1 text-[11px] leading-relaxed text-slate-600">
                            Merci d’indiquer votre nom complet et la référence de votre compte dans le motif du virement
                            pour faciliter le traitement.
                        </p>
                    </div>
                </div>

                <!-- Actions -->
                <div class="mt-3 grid grid-cols-2 gap-3">
                    <button
                        type="button"
                        class="flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.8"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 3v12m0 0l-4-4m4 4l4-4M5 19h14"
                            />
                        </svg>

                        Télécharger le RIB (PDF)
                    </button>

                    <button
                        type="button"
                        class="flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.8"
                        >
                            <rect x="8" y="8" width="11" height="11" rx="2" />
                            <path d="M5 16H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                        </svg>

                        Copier l’IBAN
                    </button>
                </div>
            </div>
        </div>
    </div>

