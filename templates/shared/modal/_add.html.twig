<!-- MODALE DEPOT -->
<div
    id="depositOverlay"
    class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4"
>
    <div class="bg-surface rounded-2xl w-full max-w-[440px] p-7 shadow-2xl">
        <div class="flex items-center justify-between mb-5">
            <h3 class="text-lg font-semibold">Recharger votre compte</h3>
            <button
                class="close-modal w-8 h-8 rounded-full hover:bg-surface2 flex items-center justify-center text-muted"
                data-modal="depositOverlay"
            >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M6 6L18 18M6 18L18 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
            </button>
        </div>
        <label class="block text-[13px] text-muted mb-1.5">Choisir un moyen de rechargement</label>

        <fieldset>
            <legend class="field-label">Type de rechargement</legend>
            <div class="grid sm:grid-cols-2 gap-3 mt-2">
                <div>
                    <input
                        type="radio"
                        name="transferType"
                        id="ty-immediate"
                        value="immediate"
                        class="peer sr-only"
                        checked
                    />
                    <label for="ty-immediate" class="transfer-type"
                        ><span class="radio-mark"></span>
                        <span class="min-w-0"
                            ><span class="flex items-center gap-2"
                                ><span class="chip-icon w-8 h-8 bg-canvas text-ink-2"
                                    ><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
                                        <path
                                            d="M13 2.5L5 13.2h6l-1 8.3 8-10.7h-6l1-8.3z"
                                            stroke="currentColor"
                                            stroke-width="1.8"
                                            stroke-linejoin="round"
                                        /></svg></span
                                ><span class="text-sm font-bold leading-tight">Carte bancaire</span></span
                            >
                            <span class="badge-credit mt-2">Recommandé</span>
                            <span class="block text-xs text-ink-3 leading-relaxed mt-2"
                                >Le rechargement est immédiat.</span
                            ></span
                        ></label
                    >
                </div>
                <div>
                    <input type="radio" name="transferType" id="ty-scheduled" value="scheduled" class="peer sr-only" />
                    <label for="ty-scheduled" class="transfer-type"
                        ><span class="radio-mark"></span>
                        <span class="min-w-0"
                            ><span class="flex items-center gap-2"
                                ><span class="chip-icon w-8 h-8 bg-canvas text-ink-2"
                                    ><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
                                        <rect
                                            x="3.5"
                                            y="5.5"
                                            width="17"
                                            height="15"
                                            rx="2.4"
                                            stroke="currentColor"
                                            stroke-width="1.8"
                                        />
                                        <path
                                            d="M3.5 10h17M8 3.5v4M16 3.5v4"
                                            stroke="currentColor"
                                            stroke-width="1.8"
                                            stroke-linecap="round"
                                        /></svg></span
                                ><span class="text-sm font-bold text-wrap leading-tight">Crypto...</span></span
                            >

                            <span class="block text-xs text-ink-3 leading-relaxed mt-2"
                                >Le rechargement sera exécuté à une date future.</span
                            ></span
                        ></label
                    >
                </div>
                <div>
                    <input type="radio" name="transferType" id="ty-recurring" value="recurring" class="peer sr-only" />
                    <label for="ty-recurring" class="transfer-type"
                        ><span class="radio-mark"></span>
                        <span class="min-w-0"
                            ><span class="flex items-center gap-2"
                                ><span class="chip-icon w-8 h-8 bg-canvas text-ink-2"
                                    ><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
                                        <rect
                                            x="3.5"
                                            y="5.5"
                                            width="17"
                                            height="15"
                                            rx="2.4"
                                            stroke="currentColor"
                                            stroke-width="1.8"
                                        />
                                        <path
                                            d="M3.5 10h17M8 3.5v4M16 3.5v4"
                                            stroke="currentColor"
                                            stroke-width="1.8"
                                            stroke-linecap="round"
                                        /></svg></span
                                ><span class="text-sm font-bold leading-tight">Carte Prépayé</span></span
                            >

                            <span class="block text-xs text-ink-3 leading-relaxed mt-2"
                                >Le rechargement après quelques minutes..</span
                            ></span
                        ></label
                    >
                </div>
                
            </div>
            <div class="mt-4" data-execution-date hidden>
                <label for="t-date" class="field-label">Date d'exécution</label>
                <input
                    id="t-date"
                    name="executionDate"
                    type="date"
                    value="2026-09-12"
                    class="field-input h-12 max-w-[260px] tnum"
                />
            </div>
        </fieldset>
    </div>
</div>
