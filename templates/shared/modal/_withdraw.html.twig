<!-- MODALE RETRAIT -->
<div
    id="withdrawOverlay"
    class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4"
>
    <div class="bg-surface rounded-2xl w-full max-w-[440px] p-7 shadow-2xl">
        <div class="flex items-center justify-between mb-5">
            <h3 class="text-lg font-semibold">Retirer des cryptos</h3>
            <button
                class="close-modal w-8 h-8 rounded-full hover:bg-surface2 flex items-center justify-center text-muted"
                data-modal="withdrawOverlay"
            >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M6 6L18 18M6 18L18 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
            </button>
        </div>
        <form onsubmit="event.preventDefault(); document.getElementById('withdrawResult').classList.remove('hidden');">
            <label class="block text-[13px] text-muted mb-1.5">Actif</label>
            <select class="w-full px-3.5 py-3 rounded-lg border border-line bg-surface2 text-[14.5px] mb-4">
                <option>Bitcoin (BTC) — solde : 0,842 BTC</option>
                <option>Ethereum (ETH) — solde : 3,210 ETH</option>
                <option>Solana (SOL) — solde : 42,5 SOL</option>
            </select>
            <label class="block text-[13px] text-muted mb-1.5">Adresse de destination</label>
            <input
                type="text"
                required
                placeholder="Adresse du portefeuille externe"
                class="w-full px-3.5 py-3 rounded-lg border border-line bg-surface2 text-[14.5px]  mb-4"
            />
            <label class="block text-[13px] text-muted mb-1.5">Montant</label>
            <input
                type="number"
                required
                placeholder="0.00"
                class="w-full px-3.5 py-3 rounded-lg border border-line bg-surface2 text-[14.5px]  mb-5"
            />
            <div
                class="bg-amber/10 border border-amber/30 rounded-lg px-4 py-3 text-[12.5px] mb-5"
                style="color: red"
            >
                Vérifiez l'adresse avant de confirmer : les transferts crypto sont irréversibles.
            </div>
            <button
                type="submit"
                class="w-full py-3.5 rounded-lg bg-gradient-to-b from-brand to-brand2 text-white text-[14.5px] font-semibold hover:brightness-110 transition"
            >
                Confirmer le retrait
            </button>
        </form>
    </div>
</div>
