{% set headerData = nexo_header_data() %}
<header
    class="sticky top-0 z-30 h-[76px] bg-white border-b border-line flex items-center gap-2 sm:gap-4 px-4 sm:px-5 lg:px-8"
>
     <a href="{{path('app_home')}}" class="flex items-center md:hidden gap-2.5 shrink-0">
             <svg width="30" height="30" viewBox="0 0 32 32" fill="none">
                    <path
                        d="M16 3c2 4 6 6 10 6-2 4-2 9 0 13-4 0-8 2-10 6-2-4-6-6-10-6 2-4 2-9 0-13 4 0 8-2 10-6z"
                        fill="#16A34A"
                    />
                    <circle cx="16" cy="16" r="4" fill="#fff" />
                </svg>
                <span class="font-head font-bold text-xl tracking-tight"
                    >Nexo Banque</span></span
                >
        </a>
    <button
        type="button"
        data-sidebar-toggle
        class="lg:hidden w-10 h-10 rounded-full border border-line flex items-center justify-center text-ink-2 shrink-0"
    >
        
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
            <path
                d="M4 7h16M4 12h16M4 17h16"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
            />
        </svg>
    </button>


    <div class="flex items-center gap-0.5 sm:gap-2 ml-auto">
        <!-- Recherche mobile -->

        <!-- MESSAGES -->
        <div class="relative" data-dropdown>
            <button type="button" data-dropdown-trigger class="topbar-icon">
                <span class="sr-only">Messages — {{headerData['unreadMessages']}} non lus</span>
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
                    <rect
                        x="3"
                        y="5.5"
                        width="18"
                        height="13"
                        rx="2.4"
                        stroke="currentColor"
                        stroke-width="1.8"
                    />
                    <path
                        d="M3.6 7l8.4 6 8.4-6"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                    />
                </svg>
                <span class="topbar-badge bg-nexo-600">{{headerData['unreadMessages']}}</span>
            </button>

            <div data-dropdown-panel class="dropdown-panel" hidden>
                <div class="dropdown-header">
                    <p class="text-sm font-extrabold">Messages</p>
                    <div class="flex items-center gap-3">
                        <span class="badge bg-nexo-100 text-nexo-700">{{headerData['unreadMessages']}} non lus</span>
                        <button
                            type="button"
                            data-dropdown-close
                            class="sm:hidden w-8 h-8 rounded-md flex items-center justify-center text-ink-3 hover:bg-canvas transition-colors"
                        >
                            <span class="sr-only">Fermer</span>
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
                                <path
                                    d="M6.5 6.5l11 11M17.5 6.5l-11 11"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                />
                            </svg>
                        </button>
                    </div>
                </div>
                <ul>
                    {% for message in headerData.messages %}
                            <li>
                                    <a href="#" class="dropdown-item dropdown-item--unread">
                                        <span
                                            class="w-9 h-9 rounded-full bg-nexo-900 text-white text-2xs font-bold flex items-center justify-center shrink-0"
                                            >{{message['initials']}}</span
                                        >
                                        <span class="min-w-0 flex-1">
                                            <span class="flex items-baseline justify-between gap-2"
                                                ><span class="text-sm font-bold truncate"
                                                    >{{message['sender']}}</span
                                                ><span class="text-2xs text-ink-4 shrink-0">{{message['date']|date('m/Y')}} à {{message['date']|date('H:m')}}</span></span
                                            >
                                            <span class="block text-xs font-semibold truncate mt-0.5"
                                                >{{message['subject']}}</span
                                            >
                                            <span class="block text-xs text-ink-3 line-clamp-2 mt-1"
                                                >{{message['excerpt']}}</span
                                            >
                                        </span>
                                        <span class="w-2 h-2 rounded-full bg-nexo-600 shrink-0 mt-1.5"></span>
                                    </a>
                            </li>
                    {% endfor %}
                </ul>
                {#<div class="dropdown-footer">#}
                {#    <a href="#" class="btn-link mx-auto"#}
                {#        >Ouvrir la messagerie#}
                {#        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">#}
                {#            <path#}
                {#                d="M5 12h14M13 6l6 6-6 6"#}
                {#                stroke="currentColor"#}
                {#                stroke-width="2"#}
                {#                stroke-linecap="round"#}
                {#                stroke-linejoin="round"#}
                {#            /></svg#}
                {#    ></a>#}
                {#</div>#}
            </div>
        </div>

        <!-- NOTIFICATIONS -->
        <div class="relative" data-dropdown>
            <button type="button" data-dropdown-trigger class="topbar-icon">
                <span class="sr-only">Notifications — {{headerData['unreadNotifications']}} non lues</span>
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
                    <path
                        d="M6.5 10a5.5 5.5 0 1111 0v4l1.6 2.6H4.9L6.5 14v-4z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                    />
                    <path
                        d="M10 19.5a2.2 2.2 0 004 0"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                    />
                </svg>
                <span class="topbar-badge bg-amber-500">{{headerData['unreadNotifications']}}</span>
            </button>

            <div data-dropdown-panel class="dropdown-panel dropdown-panel--wide" hidden>
                <div class="dropdown-header">
                    <p class="text-sm font-extrabold">Notifications</p>
                    <div class="flex items-center gap-3">
                        <button
                            type="button"
                            class="text-xs font-semibold text-nexo-700 hover:text-nexo-900 transition-colors"
                        >
                            Tout marquer comme lu
                        </button>
                        <button
                            type="button"
                            data-dropdown-close
                            class="sm:hidden w-8 h-8 rounded-md flex items-center justify-center text-ink-3 hover:bg-canvas transition-colors"
                        >
                            <span class="sr-only">Fermer</span>
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
                                <path
                                    d="M6.5 6.5l11 11M17.5 6.5l-11 11"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                />
                            </svg>
                        </button>
                    </div>
                </div>
                <ul>
                    {% for notification in headerData.notifications %}
                            <li>
                                <a href="#" class="dropdown-item dropdown-item--unread">
                                    {% if notification['type'] == 'card' %}
                                        <span
                                            class="w-9 h-9 rounded-full bg-nexo-50 text-nexo-700 flex items-center justify-center shrink-0"
                                            ><svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none">
                                                <path
                                                    d="M12 5v14M6 13l6 6 6-6"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                /></svg
                                        ></span>
                                    {% elseif notification['type'] == 'security' %}
                                        <span
                                            class="w-9 h-9 rounded-full bg-nexo-50 text-nexo-700 flex items-center justify-center shrink-0"
                                            ><svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none">
                                                <path
                                                    d="M12 5v14M6 13l6 6 6-6"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                /></svg
                                        ></span>
                                    {% else %}
                                        <span
                                            class="w-9 h-9 rounded-full bg-nexo-50 text-nexo-700 flex items-center justify-center shrink-0"
                                            ><svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none">
                                                <path
                                                    d="M12 5v14M6 13l6 6 6-6"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                /></svg
                                        ></span>
                                    {% endif %}
                                    <span class="min-w-0 flex-1"
                                        ><span class="block text-sm font-semibold"
                                            >{{ notification['title'] }}</span
                                        ><span class="block text-xs text-ink-3 mt-1"
                                            >
                                            {% if notification['amount'] is not empty %}
                                            <span class="tnum font-semibold text-credit-fg">{{notification['amount']}}</span> {% endif %}
                                            • {{ notification['date']|format_datetime(
                                                    pattern="d MMMM 'à' HH:mm",
                                                    locale='fr'
                                                ) }}</span></span
                                    >
                                    <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-1.5"></span>
                                </a>
                            </li>
                    {% endfor %}
                </ul>
                {#<div class="dropdown-footer">#}
                {#    <a href="#" class="btn-link mx-auto"#}
                {#        >Voir toutes les notifications#}
                {#        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">#}
                {#            <path#}
                {#                d="M5 12h14M13 6l6 6-6 6"#}
                {#                stroke="currentColor"#}
                {#                stroke-width="2"#}
                {#                stroke-linecap="round"#}
                {#                stroke-linejoin="round"#}
                {#            /></svg#}
                {#    ></a>#}
                {#</div>#}
            </div>
        </div>

        <span class="hidden sm:block w-px h-8 bg-line mx-1.5"></span>

        <!-- PROFIL -->
        <div class="relative" data-dropdown>
            <button
                type="button"
                data-dropdown-trigger
                class="flex items-center gap-3 pl-1 pr-1 sm:pr-2 py-1.5 rounded-lg hover:bg-canvas transition-colors"
            >
                <span class="sr-only">Ouvrir le menu du compte</span>
                <span
                    class="w-10 h-10 rounded-full bg-nexo-900 text-white text-sm font-bold flex items-center justify-center shrink-0"
                    >{{headerData['initials']}}</span
                >
                <span class="hidden md:block leading-tight text-left">
                    <span class="block text-sm font-bold">{{headerData['fullName']}}</span>
                    <span class="block text-xs text-ink-3">{{headerData['accountLabel']}} • {{headerData['currency']}}</span>
                </span>
                <svg class="hidden md:block w-3.5 h-3.5 text-ink-3" viewBox="0 0 24 24" fill="none">
                    <path
                        d="M6 9l6 6 6-6"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                    />
                </svg>
            </button>

            <div data-dropdown-panel class="dropdown-panel" hidden>
                
                <div class="px-5 py-4 border-b border-line flex items-center gap-3.5">
                    <span
                        class="w-12 h-12 rounded-full bg-nexo-900 text-white font-bold flex items-center justify-center shrink-0"
                        >{{headerData['initials']}}</span
                    >
                    <div class="min-w-0">
                        <p class="text-sm font-extrabold truncate"></p>
                        <p class="text-xs text-ink-3 truncate">{{headerData['email']}}</p>
                        <p class="text-2xs text-ink-4 tnum mt-0.5">Client n° {{headerData['reference']}}</p>
                    </div>
                </div>

                <div class="px-5 py-3 border-b border-line bg-canvas">
                    <p class="card-title">Compte sélectionné</p>
                    <div class="flex items-center justify-between gap-3 mt-2">
                        <span class="text-sm font-bold truncate">Compte principal</span>
                        <span class="badge bg-nexo-100 text-nexo-700 shrink-0">EUR</span>
                    </div>
                </div>

                <nav>
                    <a href="{{path('app_customer_dashboard')}}" class="menu-link"
                        ><svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8" />
                            <circle cx="12" cy="10" r="2.6" stroke="currentColor" stroke-width="1.8" />
                            <path
                                d="M6.6 18.4a6 6 0 0110.8 0"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                            /></svg
                        >Mon profil</a
                    >
                    <a href="{{path('app_customer_dashboard')}}" class="menu-link"
                        ><svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8" />
                            <path
                                d="M12 3.5v2.2M12 18.3v2.2M20.5 12h-2.2M5.7 12H3.5M18 6l-1.6 1.6M7.6 16.4L6 18M18 18l-1.6-1.6M7.6 7.6L6 6"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                            /></svg
                        >Paramètres</a
                    >
                    <a href="{{path('app_customer_dashboard')}}" class="menu-link border-b border-line"
                        ><svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8" />
                            <path
                                d="M9.7 9.4a2.4 2.4 0 113.8 2.2c-.85.6-1.5 1-1.5 2"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                            />
                            <circle cx="12" cy="16.6" r="1" fill="currentColor" /></svg
                        >Aide et support</a
                    >
                </nav>
                <form method="get" action="{{path('app_logout')}}">
                    <button type="submit" class="menu-link menu-link--danger w-full text-left">
                        <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none">
                            <path
                                d="M12 3.5v8"
                                stroke="currentColor"
                                stroke-width="1.9"
                                stroke-linecap="round"
                            />
                            <path
                                d="M7.4 6.6a7 7 0 109.2 0"
                                stroke="currentColor"
                                stroke-width="1.9"
                                stroke-linecap="round"
                            />
                        </svg>
                        Déconnexion
                    </button>
                </form>
                
            </div>
        </div>
    </div>
</header>