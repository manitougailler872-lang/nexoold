{#
    Navigation latérale.
    L'état actif est déduit de la route courante : aucune variable à passer
    depuis les contrôleurs.
#}
{% set route = app.request.attributes.get('_route') %}

{% set navigation = [
    {
        title: 'Tableau de bord',
        items: [
            { label: 'Tableau de bord', route: 'app_customer_dashboard', icon: 'grid', chevron: false }
        ]
    },
    {
        title: 'Comptes & cartes',
        items: [
            { label: 'Comptes',         route: 'app_customer_accounts',      icon: 'wallet' },
            { label: 'Cartes bancaires',route: 'app_customer_cards',         icon: 'card' },
            { label: 'Transactions',    route: 'app_customer_transactions',  icon: 'exchange' },
            { label: 'Virements',       route: 'app_customer_send_quicky',     icon: 'exchange' },
            { label: 'Bénéficiaires',   route: 'app_customer_external_accounts', icon: 'users' }
        ]
    },
    {
        title: 'Épargne & investissement',
        items: [
            { label: 'Investissements',   route: 'app_customer_investments', icon: 'trend' },
            { label: 'Crypto-actifs',     route: 'app_customer_cryptos',      icon: 'coin' },
            { label: 'Adresses Cryptos',   route: 'app_customer_cryptos',      icon: 'coin' }
        ]
    },
    {
        title: 'Prêts et Crédits',
        items: [
            { label: 'Mes Demandes',        route: 'app_customer_loans',         icon: 'file-check' }
        ]
    },
    {
        title: 'Patrimoines',
        items: [
            { label: 'Coffre-fort',        route: 'app_customer_loans',         icon: 'wallet' }
        ]
    },
    {
        title: 'Services',
        items: [
            { label: 'Support',    route: 'app_customer_dashboard',   icon: 'help' }
        ]
    }
] %}

<aside data-sidebar
       class="fixed inset-y-0 left-0 z-40 w-sidebar bg-white border-r border-line
              flex flex-col -translate-x-full lg:translate-x-0
              transition-transform duration-200 ease-out">

    {# ---------- Logo ---------- #}
    <div class="h-[76px] flex items-center gap-2.5 px-5 border-b border-line shrink-0">
        <a href="{{path('app_home')}}" class="flex items-center gap-2.5 shrink-0">
                <svg width="30" height="30" viewBox="0 0 32 32" fill="none">
                    <path
                        d="M16 3c2 4 6 6 10 6-2 4-2 9 0 13-4 0-8 2-10 6-2-4-6-6-10-6 2-4 2-9 0-13 4 0 8-2 10-6z"
                        fill="#16A34A"
                    />
                    <circle cx="16" cy="16" r="4" fill="#fff" />
                </svg>
                <span class="font-head font-bold text-xl tracking-tight"
                    >Nexo Banque</span></span
                >
            </a>
    </div>

    {# ---------- Menu ---------- #}
    <nav class="flex-1 overflow-y-auto px-3 pb-4" aria-label="Navigation principale">
        {% for group in navigation %}
            <p class="nav-group-title">{{ group.title }}</p>
            <ul class="space-y-0.5">
                {% for item in group.items %}
                    {% set isActive = route == item.route %}
                    <li>
                        <a href="{{ path(item.route) }}"
                           class="nav-item {{ isActive ? 'is-active' : '' }}"
                           {{ isActive ? 'aria-current="page"' : '' }}>
                            {{ include('shared/_icon.html.twig', {name: item.icon}, with_context = false) }}
                            <span class="flex-1">{{ item.label }}</span>
                            {% if item.chevron ?? true %}
                                <svg class="w-3.5 h-3.5 opacity-50" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            {% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endfor %}
    </nav>

    {# ---------- Encart support ---------- #}
    <div class="p-4 shrink-0">
        <div class="rounded-card bg-canvas border border-line p-4">
            <div class="flex items-start gap-3">
                <span class="w-9 h-9 rounded-full bg-white border border-line flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-Scotia-700" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M4.5 13a7.5 7.5 0 1115 0v4a3 3 0 01-3 3h-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        <rect x="3" y="12" width="4" height="6" rx="1.7" stroke="currentColor" stroke-width="1.8"/>
                        <rect x="17" y="12" width="4" height="6" rx="1.7" stroke="currentColor" stroke-width="1.8"/>
                    </svg>
                </span>
                <div>
                    <p class="text-sm font-bold">Besoin d'aide ?</p>
                    <p class="text-xs text-ink-3 leading-snug mt-1">Notre équipe est disponible 24h/24 et 7j/7.</p>
                </div>
            </div>
            <a href="{{ path('app_customer_dashboard') }}"
               class="mt-3.5 w-full inline-flex items-center justify-center gap-2 rounded-lg
                      border border-line bg-white px-4 py-2.5 text-sm font-semibold
                      hover:border-Scotia-600 hover:text-Scotia-700 transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4.5 13a7.5 7.5 0 1115 0v4a3 3 0 01-3 3h-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
                Contacter le support
            </a>
        </div>
    </div>
</aside>
