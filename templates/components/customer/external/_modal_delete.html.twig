{#
    Modale de confirmation de suppression.

    L'action et le jeton CSRF sont injectés par le JS depuis le déclencheur :
    ils viennent du serveur, le script ne fabrique aucune URL.
#}
<div id="beneficiary-delete-modal" class="modal" hidden
     role="alertdialog" aria-modal="true" aria-labelledby="delete-modal-title">

    <div class="modal-backdrop" data-modal-close></div>

    <div class="modal-panel sm:max-w-[440px]">
        <div class="modal-header">
            <div class="flex items-start gap-3.5">
                <span class="w-10 h-10 rounded-full bg-debit-bg text-debit-fg flex items-center justify-center shrink-0">
                    {{ include('shared/_icon.html.twig', {name: 'warning', class: 'w-5 h-5'}, with_context = false) }}
                </span>
                <div>
                    <h2 id="delete-modal-title" class="text-base font-extrabold">Supprimer ce bénéficiaire ?</h2>
                    <p class="text-xs text-ink-3 mt-1">Cette action est définitive.</p>
                </div>
            </div>
        </div>

        <div class="modal-body">
            <p class="text-sm text-ink-2 leading-relaxed">
                <strong data-field="name" class="font-extrabold"></strong> sera retiré de votre carnet.
                Les virements déjà exécutés vers ce bénéficiaire ne sont pas affectés.
            </p>

            <p class="tnum text-sm text-ink-3 mt-3 break-all" data-field="iban"></p>
        </div>

        <div class="modal-footer">
            <form method="post" action="" class="flex-1 sm:flex-none">
                <input type="hidden" name="_token" value="">
                <button type="submit"
                        class="btn w-full sm:w-auto bg-debit-fg text-white px-5 py-2.5 hover:opacity-90">
                    {{ include('shared/_icon.html.twig', {name: 'trash', class: 'w-[18px] h-[18px]'}, with_context = false) }}
                    Supprimer
                </button>
            </form>

            <button type="button" data-modal-close class="btn-ghost flex-1 sm:flex-none justify-center">
                Annuler
            </button>
        </div>
    </div>
</div>
