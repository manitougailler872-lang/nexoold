{#
    Assistant d'ajout d'un bénéficiaire — 4 étapes.

    La liste des banques est sérialisée dans un data-* : le JS filtre par pays
    sans requête supplémentaire. `|json_encode|e('html_attr')` n'est pas
    décoratif — un nom de banque contenant une apostrophe casserait l'attribut.
#}
<div id="beneficiary-add-modal" class="modal" hidden
     role="dialog" aria-modal="true" aria-labelledby="add-modal-title"
     data-banks="{{ banks|json_encode|e('html_attr') }}">

    <div class="modal-backdrop" data-modal-close></div>

    <div class="modal-panel sm:max-w-[600px]">

        {# ---------- En-tête + progression ---------- #}
        <div class="modal-header flex-col items-stretch gap-4">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 id="add-modal-title" class="text-base font-extrabold">Nouveau bénéficiaire</h2>
                    <p class="text-xs text-ink-3 mt-1">Quatre étapes, moins d'une minute.</p>
                </div>
                <button type="button" data-modal-close
                        class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-3
                               hover:bg-canvas transition-colors shrink-0">
                    <span class="sr-only">Fermer</span>
                    {{ include('shared/_icon.html.twig', {name: 'close', class: 'w-4 h-4'}, with_context = false) }}
                </button>
            </div>

            <ol class="flex items-center gap-2">
                {% for step in [
                    {n: 1, label: 'Pays'},
                    {n: 2, label: 'Banque'},
                    {n: 3, label: 'Informations'},
                    {n: 4, label: 'Récapitulatif'}
                ] %}
                    {% if not loop.first %}
                        <li class="step-bar" data-step-bar="{{ step.n - 1 }}" aria-hidden="true"></li>
                    {% endif %}
                    <li class="flex items-center gap-2 shrink-0">
                        <span class="step-dot {{ step.n == 1 ? 'is-current' : '' }}"
                              data-step-dot="{{ step.n }}">{{ step.n }}</span>
                        <span class="hidden sm:inline text-xs font-bold text-ink-3">{{ step.label }}</span>
                    </li>
                {% endfor %}
            </ol>
        </div>

        <form method="post" action="{{ path('app_beneficiary_create') }}" novalidate
              class="flex flex-col flex-1 min-h-0">
            <input type="hidden" name="_token" value="{{ csrf_token('create-beneficiary') }}">
            <div class="modal-body">
                {# ================= ÉTAPE 1 — PAYS ================= #}
                <section data-step="1" aria-labelledby="step1-title">
                    <h3 id="step1-title" class="text-sm font-extrabold">Dans quel pays est domicilié le compte ?</h3>
                    <p class="text-xs text-ink-3 mt-1.5">
                        Le pays détermine les banques proposées et le format d'IBAN attendu.
                    </p>

                    <div class="flex flex-wrap gap-2.5 mt-5">
                        {% for country in countries %}
                            <div>
                                <input type="radio" name="country" id="country-{{ country.code }}"
                                       value="{{ country.code }}" data-label="{{ country.name }}"
                                       class="peer sr-only">
                                <label for="country-{{ country.code }}" class="choice-chip">
                                    <span class="text-base leading-none" aria-hidden="true">{{ country.flag }}</span>
                                    {{ country.name }}
                                </label>
                            </div>
                        {% endfor %}
                    </div>

                    <p class="field-error mt-4" data-step-error="1" hidden></p>
                </section>

                {# ================= ÉTAPE 2 — BANQUE ================= #}
                <section data-step="2" aria-labelledby="step2-title" hidden>
                    <h3 id="step2-title" class="text-sm font-extrabold">Quelle est la banque du bénéficiaire ?</h3>
                    <p class="text-xs text-ink-3 mt-1.5">
                        Le BIC sera pré-rempli à l'étape suivante ; vous pourrez le corriger.
                    </p>

                    <div class="space-y-2.5 mt-5" data-bank-list></div>

                    <p class="text-sm text-ink-3 mt-5" data-bank-empty>
                        Choisissez d'abord un pays à l'étape précédente.
                    </p>

                    <p class="field-error mt-4" data-step-error="2" hidden></p>
                </section>

                {# ================= ÉTAPE 3 — INFORMATIONS ================= #}
                <section data-step="3" aria-labelledby="step3-title" hidden>
                    <h3 id="step3-title" class="text-sm font-extrabold">Coordonnées du bénéficiaire</h3>
                    <p class="text-xs text-ink-3 mt-1.5">
                        Le nom doit correspondre exactement à celui du titulaire du compte.
                    </p>

                    <div class="grid sm:grid-cols-2 gap-4 mt-5">
                        <div>
                            <label for="b-firstname" class="field-label">Prénom</label>
                            <input type="text" id="b-firstname" name="firstname"
                                   class="field-input" autocomplete="off" placeholder="Jean">
                            <p class="field-error" data-error="firstname" hidden></p>
                        </div>

                        <div>
                            <label for="b-lastname" class="field-label">Nom</label>
                            <input type="text" id="b-lastname" name="lastname"
                                   class="field-input" autocomplete="off" placeholder="Dupont">
                            <p class="field-error" data-error="lastname" hidden></p>
                        </div>
                    </div>

                    <div class="mt-4">
                        <label for="b-iban" class="field-label">IBAN</label>
                        <input type="text" id="b-iban" name="iban"
                               class="field-input tnum" autocomplete="off"
                               placeholder="FR76 3000 1007 9412 3456 7890 185"
                               spellcheck="false">
                        <p class="field-error" data-error="iban" hidden></p>
                        <p class="text-xs text-ink-3 mt-1.5">
                            La clé de contrôle est vérifiée à la saisie.
                        </p>
                    </div>

                    <div class="grid sm:grid-cols-2 gap-4 mt-4">
                        <div>
                            <label for="b-bic" class="field-label">BIC / SWIFT</label>
                            <input type="text" id="b-bic" name="bic"
                                   class="field-input uppercase tnum" autocomplete="off"
                                   placeholder="BNPAFRPP" spellcheck="false">
                            <p class="field-error" data-error="bic" hidden></p>
                        </div>

                        <div>
                            <label for="b-label" class="field-label">
                                Libellé <span class="font-medium text-ink-4">(facultatif)</span>
                            </label>
                            <input type="text" id="b-label" name="label"
                                   class="field-input" autocomplete="off" placeholder="Loyer, fournisseur...">
                        </div>
                    </div>
                </section>

                {# ================= ÉTAPE 4 — RÉCAPITULATIF ================= #}
                <section data-step="4" aria-labelledby="step4-title" hidden>
                    <h3 id="step4-title" class="text-sm font-extrabold">Vérifiez avant d'enregistrer</h3>
                    <p class="text-xs text-ink-3 mt-1.5">
                        Un virement envoyé vers un IBAN erroné est difficile à récupérer.
                    </p>

                    <dl class="mt-5">
                        {% for row in [
                            {key: 'name',    label: 'Titulaire'},
                            {key: 'iban',    label: 'IBAN', mono: true},
                            {key: 'bic',     label: 'BIC / SWIFT', mono: true},
                            {key: 'bank',    label: 'Banque'},
                            {key: 'country', label: 'Pays'},
                            {key: 'label',   label: 'Libellé'}
                        ] %}
                            <div class="recap-row">
                                <dt class="text-xs font-bold text-ink-3 shrink-0">{{ row.label }}</dt>
                                <dd class="text-sm font-semibold text-right break-all {{ row.mono ?? false ? 'tnum' : '' }}"
                                    data-recap="{{ row.key }}">—</dd>
                            </div>
                        {% endfor %}
                    </dl>

                    <div class="mt-5 rounded-xl bg-nexo-50 border border-nexo-100 p-4 flex gap-3">
                        {{ include('shared/_icon.html.twig', {name: 'shield', class: 'w-[18px] h-[18px] text-nexo-700 shrink-0 mt-0.5'}, with_context = false) }}
                        <p class="text-xs text-ink-2 leading-relaxed">
                            Par sécurité, le bénéficiaire reste <strong>en attente</strong> jusqu'à
                            validation par le code reçu par SMS. Aucun virement ne peut lui être
                            adressé avant cette confirmation.
                        </p>
                    </div>
                </section>
            </div>

            {# ---------- Pied de l'assistant ---------- #}
            <div class="modal-footer">
                <button type="button" data-wizard-back class="btn-ghost" hidden>
                    {{ include('shared/_icon.html.twig', {name: 'chevron-left', class: 'w-4 h-4'}, with_context = false) }}
                    Retour
                </button>

                <button type="button" data-wizard-cancel class="btn-ghost">Annuler</button>

                <button type="button" data-wizard-next class="btn-primary ml-auto">
                    Continuer
                    {{ include('shared/_icon.html.twig', {name: 'arrow-right', class: 'w-4 h-4'}, with_context = false) }}
                </button>

                <button type="submit" data-wizard-submit class="btn-primary ml-auto" hidden>
                    {{ include('shared/_icon.html.twig', {name: 'check-circle', class: 'w-[18px] h-[18px]'}, with_context = false) }}
                    Enregistrer le bénéficiaire
                </button>
            </div>
        </form>
    </div>
</div>
