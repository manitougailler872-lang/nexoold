<div class="bg-surface border border-line rounded-xl overflow-hidden">

    <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-b border-line">
        <div class="relative flex-1 min-w-[220px] max-w-[380px]">
            <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                class="absolute left-3 top-1/2 -translate-y-1/2 text-muted"
            >
                <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
                <path d="M21 21L16.5 16.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <input
                type="text"
                id="txSearch"
                placeholder="Rechercher une transaction..."
                class="w-full pl-9 pr-3 py-2.5 rounded-lg border border-line bg-surface2 text-[14px]"
            />
        </div>
        <div class="flex gap-2 text-[13px] items-center">
            <span class="px-3 py-2 rounded-lg border border-line text-muted font-mono flex items-center gap-1.5"
                ><svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6" />
                    <path d="M3 10H21" stroke="currentColor" stroke-width="1.6" /></svg
                >AOÛT 2026</span
            >
            <select id="txDirFilter" class="px-3 py-2 rounded-lg border border-line bg-surface text-[13px]">
                <option value="all">Toutes les transactions</option>
                <option value="in">Entrantes</option>
                <option value="out">Sortantes</option>
            </select>
        </div>
    </div>

    {% for transaction in transactions %}
      <div class="divide-y divide-line  fade-up" id="txRows" style="animation-delay: 0.23s">
          <div
              class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 hover:bg-surface2 transition tx-row"
              data-name="vodafone llc recharge téléphonique"
              data-dir="out"
          >
              <div class="flex items-center gap-4 min-w-[220px]">
                  <div 
                      style="background-color:{{transaction['bgColor']}}"
                      class="w-10 h-10 rounded-full bg-red-500 flex items-center justify-center text-white text-sm flex-shrink-0"
                  >
                     {{transaction['iconSvg']|raw}}
                  </div>
                  <div>
                      <div class="font-medium text-[14.5px]">{{transaction['label']}}</div>
                      <div class="text-[12.5px] text-muted">{{transaction['description']}}</div>
                  </div>
              </div>
              <div class="flex items-center gap-1.5 min-w-[110px]">
                  <span class="w-1.5 h-1.5 rounded-full text-brand2"></span>
                  <span class="px-2.5 py-1 rounded text-[12.5px] font-medium bg-up/10 text-brand2">
                      {{transaction['status']}}
                    </span>
              </div>
              <div class="text-[13.5px] text-muted min-w-[110px]">
                  #{{transaction['reference']}}
                  <div class="text-[11.5px]">{{transaction['category']}}</div>
              </div>
              <div class="text-right min-w-[130px]">
                  <div class="font-mono font-semibold">-{{ transaction['amount']|number_format(2, ',', ' ') }} {{ transaction['devise']}}</div>
                  <div class="text-[11.5px] text-muted">
                    {{ transaction['date']|format_datetime(
                        pattern="d MMMM HH:mm",
                        locale="fr"
                    ) }}
                </div>
              </div>
              <button class="text-muted text-lg">⋯</button>
          </div>
      </div>
    {% endfor %}
    <div id="txEmptyState" class="hidden flex flex-col items-center justify-center text-center px-6 py-20">
        <svg width="120" height="120" viewBox="0 0 120 120" fill="none" class="mb-6">
            <circle cx="60" cy="60" r="52" fill="#EEF4F0" />
            <rect x="34" y="42" width="52" height="38" rx="6" fill="#FFFFFF" stroke="#DCE6E0" stroke-width="2" />
            <path d="M34 54H86" stroke="#DCE6E0" stroke-width="2" />
            <rect x="42" y="62" width="24" height="4" rx="2" fill="#DCE6E0" />
            <rect x="42" y="70" width="16" height="4" rx="2" fill="#DCE6E0" />
            <circle cx="82" cy="38" r="14" fill="#0F6B44" />
            <circle cx="80" cy="36" r="9" stroke="white" stroke-width="2.2" fill="none" />
            <path d="M86.5 42.5L91 47" stroke="white" stroke-width="2.4" stroke-linecap="round" />
        </svg>
        <h3 class="font-semibold text-[16px] mb-1.5" id="txEmptyTitle">Aucune transaction trouvée</h3>
        <p class="text-muted text-[13.5px] max-w-[320px] mb-5" id="txEmptySubtitle">
            Essayez de modifier votre recherche ou vos filtres pour voir plus de résultats.
        </p>
        <button
            id="txResetFilters"
            class="px-5 py-2.5 rounded-lg border border-line text-[13.5px] font-medium hover:border-brand transition"
        >
            Réinitialiser les filtres
        </button>
    </div>
</div>
