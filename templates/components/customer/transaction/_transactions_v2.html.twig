<div class="card p-5 lg:col-span-2 sm:p-6">
    <div class="flex items-center justify-between gap-3">
        <span class="card-title">Transactions récentes</span>
        <a href="#" class="btn-link text-xs"
            >Voir toutes
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none">
                <path
                    d="M5 12h14M13 6l6 6-6 6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                /></svg
        ></a>
    </div>
    <ul class="2xl:hidden mt-4">
            {% for transaction in transactions %}
                <li class="stack-row">
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-semibold break-words">
                                {{transaction['label']}}
                        </p>
                        <p class="text-xs text-ink-3 tnum mt-1">
                            {{ transaction['date']|format_datetime(
                                pattern="d MMMM HH:mm",
                                locale="fr"
                            ) }}</p>
                        <div class="flex flex-wrap items-center gap-1.5 mt-2">
                            <span class="badge-neutral">{{ transaction['description'] }}</span><span class="badge-credit">
                             {{transaction['operation']}}
                            </span>
                        </div>
                    </div>
                    <div class="text-right shrink-0">
                        <p class="tnum text-sm font-bold whitespace-nowrap {% if transaction['operation'] == 'DEBIT' %} text-down {% else %} text-credit-fg  {% endif %}">
                            {% if transaction['operation'] == 'DEBIT' %} - {% else %} + {% endif %}
                                {{ transaction['amount']|number_format(2, ',', '') }} {{ transaction['devise']}}
                            </p>
                            <span class="inline-flex text-nexo-600 mt-2"
                                >{{transaction['status']}}</span>
                        </div>
                </li>
            {% endfor %}
    </ul>

    <table class="hidden 2xl:table w-full text-sm mt-5">
        <thead>
            <tr class="table-head text-left">
                <th class="pb-3 font-bold">Cause</th>
                <th class="pb-3 font-bold text-right">Montant</th>
                <th class="pb-3 font-bold text-center">Statut</th>
            </tr>
        </thead>
        <tbody>
             {% for transaction in transactions %}
                <tr class="table-row">
                     <td class="py-3.5 pr-3 font-medium">
                         <div class="flex items-center gap-4">
                                <div 
                                    style="background-color:{{transaction['bgColor']}}"
                                    class="w-10 h-10 rounded-full bg-red-500 flex items-center justify-center text-white text-sm flex-shrink-0"
                                >
                                    {{transaction['iconSvg']|raw}}
                                </div>
                                <div>
                                    <div class="font-medium text-[14.5px]">{{transaction['label']}}</div>
                                    <div class="text-[12.5px] text-muted">{{transaction['description']}}</div>
                                </div>
                            </div>
                    </td>
                      <td class="py-3.5 pr-3 text-right tnum font-semibold whitespace-nowrap 
                       {% if transaction['operation'] == 'DEBIT' %}  text-debit-fg {% else %}  text-credit-fg{% endif %}
                      
                    ">
                        <div class=" font-semibold"> 
                             {% if transaction['operation'] == 'DEBIT' %}-{% else %}+{% endif %}
                             {{ transaction['amount']|number_format(2, ',', ' ') }} {{ transaction['devise']}}
                        </div>
                          <div class="text-[11.5px] text-muted">
                            {{ transaction['date']|format_datetime(
                                pattern="d MMMM HH:mm",
                                locale="fr"
                            ) }}
                        </div>
                      </td>
                    <td class="py-3.5 text-center">
                        <span class="inline-flex text-nexo-600"
                            > <span class="w-1.5 h-1.5 rounded-full text-brand2"></span>
                  <span class="px-2.5 py-1 rounded text-[12.5px] font-medium
                        {% if transaction['status'] == 'Validé' %}
                            bg-emerald-100 text-emerald-700
                        {% else %}
                            bg-amber-100 text-amber-700
                        {% endif %}">
                        {{ transaction['status'] }}
                    </span></span>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <div class="mt-5 pt-5 border-t border-line">
        <a href="{{path('app_customer_transactions')}}" class="btn-link"
            >Voir toutes les transactions
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
                <path
                    d="M5 12h14M13 6l6 6-6 6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                /></svg
        ></a>
    </div>
</div>
