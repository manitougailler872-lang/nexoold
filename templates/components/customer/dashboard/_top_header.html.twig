  <!-- En-tête -->
  <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div>
            {% set period = day_period() %}
            {% if period == 'morning' %}
                <div class="flex">
                        <h1 class="text-[22px] font-extrabold tracking-tight">
                            <span>{{'👋'}} {{'Bonjour'}}</span> {{app.user.fullname}}
                        </h1>
                </div>
            {% elseif period == 'afternoon' %}
                <div class="flex">
                        <h1 class="text-[22px] font-extrabold tracking-tight">
                            <span>{{'🌤️'}} {{'Bon après-midi'}}</span> {{app.user.fullname}}
                        </h1>
                </div>
            {% elseif period == 'evening' %}
                <div class="flex">
                        <h1 class="text-[22px] font-extrabold tracking-tight">
                            <span>{{'🌙'}} {{'Bonsoir'}}</span> {{app.user.fullname}}
                        </h1>
                </div>
            {% else %}
                <div class="flex">
                        <h1 class="text-[22px] font-extrabold tracking-tight">
                            <span>{{'🌙'}} {{'Bonne nuit'}}</span> {{app.user.fullname}}
                        </h1>
                </div>
            {% endif %}
         <p class="text-sm block text-ink-3 mt-1">Voici un aperçu complet de votre situation financière.</p></div>
        <p class="flex items-center gap-2 text-xs text-ink-3">
        <span class="text-Scotia-600"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M12 3l7.2 3v6c0 4.5-3.1 8-7.2 9.2C7.9 20 4.8 16.5 4.8 12V6L12 3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9.2 12.2l2 2 3.6-3.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        Dernière connexion : {{ app.user.lastLoginAt|format_datetime(
    pattern="d MMMM yyyy 'à' HH:mm",
    locale="fr"
) }}
        </p>
  </div>