<div class="rounded-card  bank-card--emerald relative text-white p-6 relative overflow-hidden fade-up" style="animation-delay: 0.23s">
    <div class="relative z-10">
        <div class="flex items-center gap-2">
            <span class="card-title text-white/60">Valeur Totale Estimée</span>
            <button type="button" class="text-white/50 hover:text-white transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
                    <path
                        d="M2.8 12S6.5 5.8 12 5.8 21.2 12 21.2 12 17.5 18.2 12 18.2 2.8 12 2.8 12z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                    />
                    <circle cx="12" cy="12" r="2.8" stroke="currentColor" stroke-width="1.8" />
                </svg>
            </button>
        </div>
        <p class="tnum text-[28px] font-extrabold mt-3 leading-none">{{principalAccount.amount|number_format(2, ',', ' ') }} €</p>
        <p class="text-sm text-white/60 mt-2.5">Disponible</p>
        <p class="flex items-center gap-1.5 text-sm font-semibold text-Scotia-400 mt-3">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M3.5 17l5.5-5.5 3.5 3.5L20.5 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M15.5 7h5v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          +4,32% ce mois
        </p>
        
        {# <p class="flex items-center gap-1.5 text-sm font-semibold text-Scotia-400 mt-6">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
                <path
                    d="M3.5 17l5.5-5.5 3.5 3.5L20.5 7"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />
                <path
                    d="M15.5 7h5v5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />
            </svg>
            +4,32% ce mois
        </p> #}
        <div class="grid mt-3 grid-cols-5 gap-3 max-w-[420px]">
            <button
                id="openDeposit"
                class="qa-btn flex flex-col items-center gap-2"
                onclick="showToast('Fonctionnalité de démonstration.')"
            >
                <div
                    class="w-12 h-12 rounded-full bg-white border border-line flex items-center justify-center text-nblue shadow-sm"
                >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                    </svg>
                </div>
                <span class="text-[11.5px] font-medium">Recharger</span>
            </button>
            
            <a href="{{path('app_transfer_new')}}" class="qa-btn flex flex-col items-center gap-2">
                <div
                    class="w-12 h-12 rounded-full bg-white border border-line flex items-center justify-center text-nviolet shadow-sm"
                >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                         <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <span class="text-[11.5px] font-medium">Envoyer</span>
            </a>
               <button
               id="showRib"
                class="qa-btn flex flex-col items-center gap-2"
            >
                <div
                    class="w-12 h-12 rounded-full bg-white border border-line flex items-center justify-center text-nviolet shadow-sm"
                >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M13.8 3.5v4.7h4.7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M18.5 8.8V19a1.8 1.8 0 01-1.8 1.8H7.3A1.8 1.8 0 015.5 19V5.3a1.8 1.8 0 011.8-1.8h6.5l4.7 5.3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    </svg>
                </div>
                <span class="text-[11.5px] font-medium">Mon Rib</span>
            </button>

        </div>
    </div>
    <svg viewBox="0 0 240 160" class="absolute right-[-28px] bottom-3 w-52 sm:w-60" style="transform:rotate(-10deg)">
        <rect x="18" y="14" width="204" height="132" rx="16" fill="#16522F"/>
        <path d="M18 104 C90 74 150 62 222 30 L222 146 L18 146 Z" fill="#3AA55C" opacity="0.35"/>
        <g stroke="#fff" stroke-width="2.6" fill="none" opacity=".92" stroke-linecap="round">
          <path d="M150 80 a11 11 0 0 1 0 22"/><path d="M157 73 a20 20 0 0 1 0 36"/>
        </g>
        <rect x="176" y="82" width="27" height="20" rx="3" fill="#E4C260"/>
        <path d="M176 92h27M189.5 82v20" stroke="#B8942F" stroke-width="1"/>
      </svg>
</div>
