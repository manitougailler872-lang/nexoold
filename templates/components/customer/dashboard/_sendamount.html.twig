<div id="transfer" class="bg-surface border border-line rounded-xl p-6 fade-up" style="animation-delay: 0.23s">
    <h3 class="font-semibold text-[15.5px] mb-4">Envoyer de l'argent</h3>
    <div class="flex items-center gap-3 mb-5 overflow-x-auto pb-1">
        {% for external in externalAccounts %}
            <button
                type="button"
                class="qa-btn  flex flex-col items-center gap-1.5 flex-shrink-0"
                data-name="Marie"
            >
                <div
                    style="background-color:{{external.bgColor}}"
                    class="w-12 h-12 rounded-full text-white flex items-center justify-center font-semibold border-2 border-transparent"
                >
                    {{external.firstname|first}}
                </div>
                <span class="text-[11px]">{{external.firstname}}</span>
            </button>
        {% endfor %}
    </div>
    <form onsubmit="event.preventDefault(); showToast('Transfert simulé — démonstration.');">
        <div class="mb-3">
            <label class="block text-[12.5px] text-muted mb-1.5">Montant</label>
            <div class="flex gap-2">
                <input
                    type="number"
                    placeholder="0,00"
                    class="flex-1 px-3.5 py-2.5 rounded-xl border border-line bg-panel text-[14.5px] "
                />
                <select class="px-3 py-2.5 rounded-xl border border-line bg-panel text-[13.5px]">
                    <option>EUR</option>
                    <option>USD</option>
                    <option>GBP</option>
                </select>
            </div>
        </div>
        <div class="mb-4">
            <label class="block text-[12.5px] text-muted mb-1.5">Message (optionnel)</label>
            <input
                type="text"
                placeholder="Ex : Remboursement resto"
                class="w-full px-3.5 py-2.5 rounded-xl border border-line bg-panel text-[13.5px]"
            />
        </div>
        <button
            type="submit"
            class="w-full py-3 rounded-xl bg-[#1B5E3A] text-white text-[14px] font-semibold hover:brightness-110 transition"
        >
            Continuer
        </button>
    </form>
</div>
