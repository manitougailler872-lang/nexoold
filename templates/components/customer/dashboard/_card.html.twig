<article class="bank-card bank-card--emerald-deep fade-up" style="animation-delay: 0.23s">
    <div class="flex items-start justify-between">
        <span class="text-xl flex font-black italic text-white" aria-label="Visa">
        <svg width="30" height="30" viewBox="0 0 32 32" fill="none">
                    <path
                        d="M16 3c2 4 6 6 10 6-2 4-2 9 0 13-4 0-8 2-10 6-2-4-6-6-10-6 2-4 2-9 0-13 4 0 8-2 10-6z"
                        fill="#16A34A"
                    />
                    <circle cx="16" cy="16" r="4" fill="#fff" />
                </svg>&nbsp;Nexo Visa</span>
        <button
            type="button"
            class="w-7 h-7 -mr-1 -mt-1 flex items-center justify-center rounded-md text-white/70 hover:bg-white/10 transition-colors"
        >
            <span class="sr-only">Actions sur la carte 4008</span
            ><svg class="w-4 h-4 rotate-90" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="5.5" r="1.6" fill="currentColor" />
                <circle cx="12" cy="12" r="1.6" fill="currentColor" />
                <circle cx="12" cy="18.5" r="1.6" fill="currentColor" />
            </svg>
        </button>
    </div>
    <p class="bank-card-pan mt-6">
        {{ card['first4']}} <span class="text-white/60">**** ****</span> {{ card['last4']}}
    </p>
    <p class="text-xs font-medium mt-1.5 bank-card-muted">{{ card['type']}} • {{ card['tier']}}</p>
    <div class="flex items-end justify-between gap-4 mt-6">
        <div class="min-w-0">
            <p class="text-2xs font-semibold uppercase tracking-[0.08em] bank-card-muted">Solde disponible</p>
            <p class="tnum text-[22px] font-semibold mt-1.5 leading-none">
                {{ card['availableBalance']|number_format(2, ',', ',')}} €
            </p>
        </div>
        <div class="relative w-[58px] h-[58px] shrink-0">
            <svg class="w-full h-full -rotate-90" viewBox="0 0 58 58" aria-hidden="true">
                <circle cx="29" cy="29" r="22" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="5" />
                <circle
                    cx="29"
                    cy="29"
                    r="22"
                    fill="none"
                    stroke="{{ card['gaugeColor']}}"
                    stroke-width="5"
                    stroke-linecap="round"
                    stroke-dasharray="89.85 48.38"
                />
            </svg>
            <span class="absolute inset-0 flex items-center justify-center text-xs font-semibold text-white"
                >{{ card['limitUsedPercent']}}%</span
            >
        </div>
    </div>
    <div class="flex items-end justify-between gap-4 mt-3">
        <div>
            <p class="tnum text-sm font-semibold">{{ card['expiry']}}</p>
            <p class="text-2xs bank-card-muted">Expire fin</p>
        </div>
        <p class="text-2xs bank-card-muted text-center w-[58px] shrink-0">du plafond</p>
    </div>
    <div class="flex items-center gap-2 mt-auto pt-5">
        <a href="{{path('app_customer_dashboard')}}" class="bank-card-action">Voir détails</a>
        <button type="button" class="bank-card-icon-action">
            <span class="sr-only">Bloquer la carte 4008</span
            ><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
                <rect x="5" y="10.5" width="14" height="10" rx="2.4" stroke="currentColor" stroke-width="1.8" />
                <path
                    d="M8.5 10.5V7.6a3.5 3.5 0 017 0v2.9"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                />
            </svg>
        </button>
    </div>
</article>
