{#
    Écran de traitement affiché après la confirmation du virement.
    `data-duration` pilote la durée : une seule valeur à ajuster si le délai
    doit changer. L'écran est purement informatif — c'est la réponse du
    serveur qui décide de l'acceptation de l'ordre.
#}
<div id="transfer-progress-overlay" class="progress-overlay" hidden
     data-duration="{{ processingSeconds|default(60) }}"
     role="dialog" aria-modal="true" aria-labelledby="progress-title">
    <div class="progress-card">
        <div class="spinner" aria-hidden="true"></div>
        <h2 id="progress-title" class="text-lg font-extrabold mt-5">Traitement de votre virement</h2>
        <p class="text-sm text-ink-3 mt-2 leading-relaxed">
            Ne fermez pas cette page. Vous recevrez un code de validation à la fin du traitement.
        </p>
        {# ---------- Barre de progression ---------- #}
        <div class="mt-6">
            <div class="progress-track"
                 role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
                 aria-labelledby="progress-title">
                <div class="progress-fill" style="width: 0%" data-progress-fill></div>
            </div>
            <div class="flex items-center justify-between gap-3 mt-2.5 text-xs text-ink-3">
                <span class="tnum font-bold text-ink" data-progress-percent>0 %</span>
                {# aria-live : un lecteur d'écran doit être informé de l'avancement,
                   mais « polite » pour ne pas interrompre la lecture en cours. #}
                <span class="tnum" data-progress-remaining aria-live="polite">Préparation…</span>
            </div>
        </div>
        {# ---------- Étapes ---------- #}
        <ol class="mt-6 space-y-3">
            {% for step in [
                'Vérification du solde et des plafonds',
                'Contrôles de conformité',
                "Enregistrement de l'ordre",
                'Envoi du code de validation'
            ] %}
                <li class="progress-step" data-progress-step>
                    <span class="progress-step-mark">
                        {{ include('shared/_icon.html.twig', {name: 'check', class: 'w-3 h-3'}, with_context = false) }}
                    </span>
                    {{ step }}
                </li>
            {% endfor %}
        </ol>
        <button type="button" data-progress-cancel
                class="btn-ghost w-full justify-center mt-6 h-10 text-sm">
            Annuler
        </button>
    </div>
</div>
