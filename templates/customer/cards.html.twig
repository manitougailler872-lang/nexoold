{% block javascripts %}
<script>
(function(){



/* ------------------------------------------------------------------ *
 *  Masquage des soldes
 * ------------------------------------------------------------------ */

/**
 * Remplace les montants par des points.
 *
 * Utile en open space ou en partage d'écran. Le choix est conservé pour la
 * session via sessionStorage plutôt que localStorage : le masquage répond à
 * un contexte ponctuel, pas à une préférence durable, et il ne doit pas
 * survivre à la fermeture du navigateur sur un poste partagé.
 *
 * Le montant réel reste dans le DOM (attribut data-real) : c'est un confort
 * d'affichage, pas une mesure de sécurité.
 */
function initBalanceMask() {
    const toggle = document.querySelector('[data-mask-toggle]');
    const targets = Array.from(document.querySelectorAll('[data-maskable]'));

    if (!toggle || targets.length === 0) return;

    const label = toggle.querySelector('[data-mask-label]');
    const KEY = 'nexotrade:mask-balances';

    targets.forEach((el) => {
        el.dataset.real = el.textContent.trim();
    });

    function apply(masked) {
        targets.forEach((el) => {
            el.textContent = masked ? '••••••' : el.dataset.real;
        });

        if (label) label.textContent = masked ? 'Afficher les soldes' : 'Masquer les soldes';
        toggle.setAttribute('aria-pressed', masked ? 'true' : 'false');

        try {
            sessionStorage.setItem(KEY, masked ? '1' : '0');
        } catch (error) {
            // Navigation privée ou stockage refusé : le masquage fonctionne
            // quand même, il n'est simplement pas mémorisé.
        }
    }

    let initial = false;
    try {
        initial = sessionStorage.getItem(KEY) === '1';
    } catch (error) {
        initial = false;
    }

    apply(initial);

    toggle.addEventListener('click', () => {
        apply(toggle.getAttribute('aria-pressed') !== 'true');
    });
}
initBalanceMask();
})();
</script>
{% endblock %}