{% extends 'shared/_base.html.twig' %}

{% block title %}Transactions — NexoTrade{% endblock %}

{#
    Palette des catégories.
    Centralisée ici plutôt que dans chaque ligne : ajouter une catégorie côté
    base ne demande qu'une entrée supplémentaire, et le `default` garantit
    qu'une catégorie inconnue s'affiche proprement au lieu de casser le rendu.
#}
{% set categoryStyles = {
    'Logement':         {icon: 'home',     bg: 'bg-nexo-50',   fg: 'text-nexo-600'},
    'Courses':          {icon: 'cart',     bg: 'bg-amber-50',  fg: 'text-amber-600'},
    'Transport':        {icon: 'exchange', bg: 'bg-blue-50',   fg: 'text-blue-600'},
    'Abonnements':      {icon: 'file',     bg: 'bg-purple-50', fg: 'text-purple-600'},
    'Loisirs & autres': {icon: 'heart',    bg: 'bg-pink-50',   fg: 'text-pink-600'}
} %}

{% block content %}

    {# ---------- En-tête ---------- #}
    <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div>
            <h1 class="text-[22px] font-extrabold tracking-tight">Transactions</h1>
            <p class="text-sm text-ink-3 mt-1">Consultez et gérez l'ensemble de vos opérations.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
            <a href="{{ path('app_customer_transactions', filters|default({})) }}"
               class="btn-ghost flex-1 sm:flex-none justify-center">
                {{ include('shared/_icon.html.twig', {name: 'arrow-down', class: 'w-[18px] h-[18px]'}, with_context = false) }}
                Exporter
            </a>
        </div>
    </div>
        <!-- Comptes + transactions -->
        {% include 'components/customer/transaction/_transactions_v2.html.twig' %}
{% endblock %}