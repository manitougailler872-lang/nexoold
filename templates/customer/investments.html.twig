/**
 * Défilement horizontal piloté par boutons.
 *
 * Le conteneur reste un simple élément à débordement : le geste tactile et la
 * molette fonctionnent nativement, et la liste demeure utilisable sans
 * JavaScript. Les boutons ne font qu'ajouter un confort au pointeur.
 */
function initScrollers() {
    document.querySelectorAll('[data-scroller]').forEach((track) => {
        const id = track.id;
        if (!id) return;

        const prev = document.querySelector(`[data-scroller-prev="${id}"]`);
        const next = document.querySelector(`[data-scroller-next="${id}"]`);

        function step() {
            // On défile d'une carte entière plutôt que d'une largeur fixe :
            // le pas reste juste quelle que soit la taille d'écran.
            const first = track.querySelector('li');
            if (!first) return track.clientWidth;

            const gap = parseFloat(getComputedStyle(track).columnGap || '0');

            return first.getBoundingClientRect().width + gap;
        }

        function refresh() {
            // Marge d'un pixel : les navigateurs arrondissent scrollLeft,
            // et une comparaison stricte laisserait un bouton actif à vide.
            const max = track.scrollWidth - track.clientWidth;

            if (prev) prev.disabled = track.scrollLeft <= 1;
            if (next) next.disabled = track.scrollLeft >= max - 1;
        }

        prev?.addEventListener('click', () => {
            track.scrollBy({ left: -step(), behavior: 'smooth' });
        });

        next?.addEventListener('click', () => {
            track.scrollBy({ left: step(), behavior: 'smooth' });
        });

        track.addEventListener('scroll', refresh, { passive: true });
        window.addEventListener('resize', refresh);

        refresh();
    });
}

/**
 * Comportements propres au gabarit à navigation horizontale.
 */

/* ------------------------------------------------------------------ *
 *  Menu dépliant de la barre horizontale
 * ------------------------------------------------------------------ */

function initTopnav() {
    const toggle = document.querySelector('[data-topnav-toggle]');
    const menu = document.getElementById('topnav-menu');

    if (!toggle || !menu) return;

    function setOpen(open) {
        menu.hidden = !open;
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    toggle.addEventListener('click', () => setOpen(menu.hidden));

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
            setOpen(false);
            toggle.focus();
        }
    });

    // Un clic à l'extérieur referme, comme pour les menus déroulants.
    document.addEventListener('click', (event) => {
        if (menu.hidden) return;
        if (menu.contains(event.target) || toggle.contains(event.target)) return;
        setOpen(false);
    });
}

/* ------------------------------------------------------------------ *
 *  Masquage des soldes
 * ------------------------------------------------------------------ */

/**
 * Remplace les montants par des points.
 *
 * Utile en open space ou en partage d'écran. Le choix est conservé pour la
 * session via sessionStorage plutôt que localStorage : le masquage répond à
 * un contexte ponctuel, pas à une préférence durable, et il ne doit pas
 * survivre à la fermeture du navigateur sur un poste partagé.
 *
 * Le montant réel reste dans le DOM (attribut data-real) : c'est un confort
 * d'affichage, pas une mesure de sécurité.
 */
function initBalanceMask() {
    const toggle = document.querySelector('[data-mask-toggle]');
    const targets = Array.from(document.querySelectorAll('[data-maskable]'));

    if (!toggle || targets.length === 0) return;

    const label = toggle.querySelector('[data-mask-label]');
    const KEY = 'nexotrade:mask-balances';

    targets.forEach((el) => {
        el.dataset.real = el.textContent.trim();
    });

    function apply(masked) {
        targets.forEach((el) => {
            el.textContent = masked ? '••••••' : el.dataset.real;
        });

        if (label) label.textContent = masked ? 'Afficher les soldes' : 'Masquer les soldes';
        toggle.setAttribute('aria-pressed', masked ? 'true' : 'false');

        try {
            sessionStorage.setItem(KEY, masked ? '1' : '0');
        } catch (error) {
            // Navigation privée ou stockage refusé : le masquage fonctionne
            // quand même, il n'est simplement pas mémorisé.
        }
    }

    let initial = false;
    try {
        initial = sessionStorage.getItem(KEY) === '1';
    } catch (error) {
        initial = false;
    }

    apply(initial);

    toggle.addEventListener('click', () => {
        apply(toggle.getAttribute('aria-pressed') !== 'true');
    });
}

initScrollers();
initBalanceMask();
</script>
