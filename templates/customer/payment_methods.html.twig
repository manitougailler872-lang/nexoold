{% extends 'shared/_base.html.twig' %}
{% block content %}
    
{% endblock %}
{% block javascripts %}
    <div class="mb-6">
        <h2 class="text-2xl font-semibold mb-1">Moyens de paiement</h2>
        <p class="text-muted text-[14.5px]">Gérez vos comptes bancaires et vos adresses de cryptomonnaies</p>
    </div>
    <div class="space-y-6 max-w-[820px]">
        <!-- MOYEN DE PAIEMENT (bancaire) -->
        <div class="bg-surface border border-line rounded-2xl p-7">
            <h3 class="font-semibold text-[17px] mb-5">Moyen de paiement</h3>

            <div class="flex items-start gap-3 mb-5">
                <div
                    class="w-10 h-10 rounded-lg bg-surface2 border border-line flex items-center justify-center text-brand2 flex-shrink-0"
                >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <path d="M3 10L12 3L21 10" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                        <rect x="4" y="10" width="16" height="9" stroke="currentColor" stroke-width="1.8" />
                        <path d="M2 21H22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                </div>
                <div>
                    <div class="font-medium">Mon compte bancaire</div>
                    <div class="text-[13px] text-muted">Consultez et gérez vos virements et retraits en euros.</div>
                </div>
            </div>

            <div id="bankAccountsMini" class="space-y-2 mb-3"></div>

            <a
                href="nexotrade-dash-external-accounts.html"
                class="w-full flex items-center justify-center gap-2 py-4 rounded-xl border-2 border-dashed border-line hover:border-brand transition text-[14.5px] font-medium text-ink"
            >
                Ajouter un compte
                <span
                    class="w-6 h-6 rounded-full border-2 border-ink flex items-center justify-center text-[15px] leading-none"
                    >+</span
                >
            </a>
        </div>
        <!-- ADRESSE DE CRYPTOMONNAIES -->
        <div class="bg-surface border border-line rounded-2xl p-7">
            <h3 class="font-semibold text-[17px] mb-5">Adresse de cryptomonnaies</h3>

            <div class="flex items-start gap-3 mb-5">
                <div
                    class="w-10 h-10 rounded-lg bg-surface2 border border-line flex items-center justify-center text-brand2 flex-shrink-0"
                >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
                        <path
                            d="M9.5 8.5H13.2C14.2 8.5 15 9.3 15 10.3C15 11.3 14.2 12 13.2 12H9.5M9.5 12H13.5C14.5 12 15.3 12.8 15.3 13.8C15.3 14.8 14.5 15.5 13.5 15.5H9.5M11 8.5V6.5M11 17.5V15.5"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                        />
                    </svg>
                </div>
                <div>
                    <div class="font-medium">Mes adresses cryptomonnaies</div>
                    <div class="text-[13px] text-muted">Consultez et gérez vos adresses de cryptomonnaies.</div>
                </div>
            </div>

            <div id="cryptoAddressesList" class="space-y-2 mb-3"></div>

            <button
                id="openAddAddress"
                class="w-full flex items-center justify-center gap-2 py-4 rounded-xl border-2 border-dashed border-line hover:border-brand transition text-[14.5px] font-medium text-ink"
            >
                Ajouter une adresse
                <span
                    class="w-6 h-6 rounded-full border-2 border-ink flex items-center justify-center text-[15px] leading-none"
                    >+</span
                >
            </button>
        </div>
    </div>
    <!-- ===== MODALE AJOUT ADRESSE CRYPTO ===== -->
    <div
        id="addAddressOverlay"
        class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-surface rounded-2xl w-full max-w-[480px] max-h-[92vh] overflow-y-auto shadow-2xl">
            <div class="flex items-center justify-between px-7 pt-7 pb-2">
                <h3 class="text-lg font-semibold">Ajouter une adresse crypto</h3>
                <button
                    id="closeAddAddress"
                    class="w-8 h-8 rounded-full hover:bg-surface2 flex items-center justify-center text-muted"
                >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M6 6L18 18M6 18L18 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
            </div>

            <div class="flex items-center justify-center px-7 py-6">
                <div class="step-dot active" id="addr-dot-1"><span>1</span></div>
                <div class="step-line" id="addr-line-1"><div></div></div>
                <div class="step-dot" id="addr-dot-2"><span>2</span></div>
            </div>

            <div class="px-7 pb-7">
                <div class="relative overflow-hidden">
                    <!-- STEP 1 — TYPE DE CRYPTO -->
                    <div class="addr-step animate-stepIn" data-step="1">
                        <h4 class="font-medium text-[17px] mb-1">Choisissez la cryptomonnaie</h4>
                        <p class="text-muted text-[13.5px] mb-5">
                            Sélectionnez l'actif pour lequel vous souhaitez enregistrer une adresse
                        </p>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="cryptoTypeGrid"></div>
                    </div>

                    <!-- STEP 2 — ADRESSE -->
                    <div class="addr-step hidden" data-step="2">
                        <h4 class="font-medium text-[17px] mb-1">Renseignez l'adresse</h4>
                        <p class="text-muted text-[13.5px] mb-5" id="selectedCryptoLabel"></p>
                        <form id="addressForm">
                            <div class="mb-4" id="networkFieldWrap">
                                <label class="block text-[13px] text-muted mb-1.5">Réseau</label>
                                <select
                                    id="networkSelect"
                                    class="w-full px-3.5 py-3 rounded-lg border border-line bg-surface2 text-[14.5px]"
                                ></select>
                            </div>
                            <div class="mb-4">
                                <label class="block text-[13px] text-muted mb-1.5">Adresse du portefeuille</label>
                                <input
                                    type="text"
                                    id="addrValue"
                                    required
                                    placeholder="Collez l'adresse ici"
                                    class="w-full px-3.5 py-3 rounded-lg border border-line bg-surface2 text-[14.5px] font-mono"
                                />
                            </div>
                            <div class="mb-2">
                                <label class="block text-[13px] text-muted mb-1.5">Libellé (optionnel)</label>
                                <input
                                    type="text"
                                    id="addrLabel"
                                    placeholder="Ex : Mon portefeuille Ledger"
                                    class="w-full px-3.5 py-3 rounded-lg border border-line bg-surface2 text-[14.5px]"
                                />
                            </div>
                            <div
                                class="bg-amber/10 border border-amber/30 rounded-lg px-4 py-3 text-[12.5px] my-5"
                                style="color: #6b4a16"
                            >
                                Vérifiez que l'adresse correspond bien au réseau sélectionné. Un envoi vers une mauvaise
                                adresse est irréversible.
                            </div>
                        </form>
                        <div class="flex justify-between">
                            <button
                                id="addr-back"
                                class="px-6 py-3 rounded-lg text-[14.5px] font-semibold border border-line hover:border-brand transition"
                            >
                                Précédent
                            </button>
                            <button
                                id="addr-save"
                                class="px-6 py-3 rounded-lg text-[14.5px] font-semibold bg-gradient-to-b from-brand to-brand2 text-white hover:brightness-110 transition"
                            >
                                Enregistrer l'adresse
                            </button>
                        </div>
                    </div>

                    <!-- SUCCESS -->
                    <div class="addr-step hidden text-center py-4" data-step="3">
                        <div
                            class="success-check w-20 h-20 rounded-full bg-up/10 flex items-center justify-center mx-auto mb-5"
                        >
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none">
                                <path
                                    id="addrCheckPath"
                                    d="M5 13L9 17L19 7"
                                    stroke="#1F8F5C"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </div>
                        <h4 class="font-semibold text-[19px] mb-2">Adresse enregistrée</h4>
                        <p class="text-muted text-[14px] mb-6">Vous pouvez désormais l'utiliser pour vos retraits.</p>
                        <button
                            id="addr-finish"
                            class="px-7 py-3 rounded-lg text-[14.5px] font-semibold bg-gradient-to-b from-brand to-brand2 text-white hover:brightness-110 transition"
                        >
                            Terminé
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% block javascripts %}

<script>
  const CRYPTOS = [
    { id: 'bitcoin', symbol: 'BTC', name: 'Bitcoin', color: '#F7931A', networks: ['Bitcoin'] },
    { id: 'ethereum', symbol: 'ETH', name: 'Ethereum', color: '#627EEA', networks: ['ERC20 (Ethereum)'] },
    { id: 'usdt', symbol: 'USDT', name: 'Tether', color: '#26A17B', networks: ['ERC20 (Ethereum)', 'TRC20 (Tron)', 'BEP20 (BNB Chain)'] },
    { id: 'solana', symbol: 'SOL', name: 'Solana', color: '#14F195', networks: ['Solana'] },
    { id: 'bnb', symbol: 'BNB', name: 'BNB', color: '#F0B90B', networks: ['BEP20 (BNB Chain)'] },
    { id: 'xrp', symbol: 'XRP', name: 'Ripple', color: '#23292F', networks: ['XRP Ledger'] },
  ];

  let selectedCrypto = null;
  const savedAddresses = [];

  // Comptes bancaires déjà liés (repris de la page Comptes externes)
  document.getElementById('bankAccountsMini').innerHTML = `
    <div class="flex items-center justify-between px-4 py-3 rounded-lg bg-surface2 border border-line">
      <div class="flex items-center gap-3"><div class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center text-blue-600 font-bold text-[10px]">BNP</div><div><div class="font-medium text-[13.5px]">BNP Paribas &middot; France</div><div class="text-[11.5px] text-muted font-mono">FR76 3000 •••• 045</div></div></div>
      <span class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-up/10 text-brand2">Vérifié</span>
    </div>`;

  function renderCryptoTypeGrid(){
    document.getElementById('cryptoTypeGrid').innerHTML = CRYPTOS.map(c => `
      <button type="button" class="crypto-type-btn p-4 rounded-xl border border-line hover:border-brand transition text-left flex items-center gap-3" data-id="${c.id}">
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-white font-bold text-[11px] flex-shrink-0" style="background:${c.color}">${c.symbol.slice(0,3)}</div>
        <div><div class="font-medium text-[14px]">${c.symbol}</div><div class="text-[11.5px] text-muted">${c.name}</div></div>
      </button>`).join('');
    document.querySelectorAll('.crypto-type-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        selectedCrypto = CRYPTOS.find(c => c.id === btn.dataset.id);
        goToAddrStep(2);
      });
    });
  }

  function renderAddressesList(){
    const list = document.getElementById('cryptoAddressesList');
    if(savedAddresses.length === 0){ list.innerHTML = ''; return; }
    list.innerHTML = savedAddresses.map(a => `
      <div class="flex items-center justify-between px-4 py-3 rounded-lg bg-surface2 border border-line">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-white font-bold text-[10px] flex-shrink-0" style="background:${a.crypto.color}">${a.crypto.symbol.slice(0,3)}</div>
          <div>
            <div class="font-medium text-[13.5px]">${a.label || a.crypto.name} <span class="text-muted font-normal">&middot; ${a.network}</span></div>
            <div class="text-[11.5px] text-muted font-mono">${a.address.slice(0,10)}…${a.address.slice(-6)}</div>
          </div>
        </div>
        <button class="text-muted text-[12px] hover:text-down transition remove-addr" data-idx="${savedAddresses.indexOf(a)}">Supprimer</button>
      </div>`).join('');
    list.querySelectorAll('.remove-addr').forEach(btn => {
      btn.addEventListener('click', () => {
        savedAddresses.splice(parseInt(btn.dataset.idx), 1);
        renderAddressesList();
      });
    });
  }

  const addrOverlay = document.getElementById('addAddressOverlay');
  document.getElementById('openAddAddress').addEventListener('click', () => {
    renderCryptoTypeGrid();
    goToAddrStep(1);
    addrOverlay.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  });
  function closeAddrOverlay(){ addrOverlay.classList.add('hidden'); document.body.style.overflow = ''; }
  document.getElementById('closeAddAddress').addEventListener('click', closeAddrOverlay);
  addrOverlay.addEventListener('click', e => { if(e.target === addrOverlay) closeAddrOverlay(); });

  function goToAddrStep(step){
    document.querySelectorAll('.addr-step').forEach(s => s.classList.add('hidden'));
    const target = document.querySelector(`.addr-step[data-step="${step}"]`);
    target.classList.remove('hidden');
    target.classList.remove('animate-stepIn'); void target.offsetWidth; target.classList.add('animate-stepIn');

    for(let i = 1; i <= 2; i++){
      const dot = document.getElementById('addr-dot-' + i);
      if(!dot) continue;
      dot.className = 'step-dot';
      if(step === 3 || i < step) dot.classList.add('done');
      else if(i === step) dot.classList.add('active');
    }
    document.getElementById('addr-line-1').classList.toggle('filled', step >= 2);

    if(step === 2 && selectedCrypto){
      document.getElementById('selectedCryptoLabel').textContent = `Adresse ${selectedCrypto.name} (${selectedCrypto.symbol})`;
      const netSelect = document.getElementById('networkSelect');
      netSelect.innerHTML = selectedCrypto.networks.map(n => `<option>${n}</option>`).join('');
      document.getElementById('networkFieldWrap').style.display = selectedCrypto.networks.length > 1 ? '' : 'none';
    }
  }

  document.getElementById('addr-back').addEventListener('click', () => goToAddrStep(1));

  document.getElementById('addr-save').addEventListener('click', () => {
    const form = document.getElementById('addressForm');
    if(!form.reportValidity()) return;
    savedAddresses.push({
      crypto: selectedCrypto,
      network: document.getElementById('networkSelect').value,
      address: document.getElementById('addrValue').value,
      label: document.getElementById('addrLabel').value,
    });
    renderAddressesList();
    goToAddrStep(3);
  });

  document.getElementById('addr-finish').addEventListener('click', () => {
    closeAddrOverlay();
    setTimeout(() => {
      selectedCrypto = null;
      document.getElementById('addressForm').reset();
    }, 300);
  });
</script>


<script>
  // Menu mobile (tiroir coulissant)
  (function(){
    const sidebar = document.getElementById('sidebarNav');
    const backdrop = document.getElementById('sidebarBackdrop');
    const openBtn = document.getElementById('mobileSidebarBtn');
    const closeBtn = document.getElementById('closeSidebarBtn');
    if(!sidebar || !backdrop) return;

    function openSidebar(){
      sidebar.classList.remove('-translate-x-full');
      backdrop.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar(){
      sidebar.classList.add('-translate-x-full');
      backdrop.classList.add('hidden');
      document.body.style.overflow = '';
    }
    if(openBtn) openBtn.addEventListener('click', openSidebar);
    if(closeBtn) closeBtn.addEventListener('click', closeSidebar);
    backdrop.addEventListener('click', closeSidebar);
    // Ferme le menu si on clique un lien de navigation (mobile)
    sidebar.querySelectorAll('a').forEach(a => a.addEventListener('click', closeSidebar));
    // Ferme automatiquement si la fenêtre repasse en desktop
    window.addEventListener('resize', () => { if(window.innerWidth >= 1024) closeSidebar(); });
  })();
</script>
{% endblock %}