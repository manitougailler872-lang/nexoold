{% extends 'shared/_base.html.twig' %}
{% block content %}
<div class="flex flex-wrap items-start justify-between gap-4 mb-6">
    <div>
        <h1 class="text-[22px] font-extrabold tracking-tight">Virements</h1>
        <p class="text-sm text-ink-3 mt-1">Retrouvez l'ensemble de vos virements émis et leur statut.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
        <a href="#" class="btn-ghost flex-1 sm:flex-none justify-center"
            ><svg class="w-[18px] h-[18px] rotate-180" viewBox="0 0 24 24" fill="none">
                <path
                    d="M12 15V4m0 11l-3.6-3.6M12 15l3.6-3.6"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />
                <path
                    d="M4.5 16v2.5a1.5 1.5 0 001.5 1.5h12a1.5 1.5 0 001.5-1.5V16"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                />
            </svg>
            Exporter</a
        >
        <a href="{{path('app_customer_send_quicky')}}" class="btn-primary flex-1 sm:flex-none justify-center"
            >   
            {{ include('shared/_icon.html.twig', {name: 'add', class: 'w-[18px] h-[18px]'}, with_context = false) }}
            Nouveau virement</a
        >
    </div>
</div>

<div class="card grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-line mb-5">
    <div class="stat-tile">
        <span class="stat-icon stat-icon--solid"
            ><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
                <path
                    d="M4 8h13l-3.2-3.2M20 16H7l3.2 3.2"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                /></svg
        ></span>
        <div class="min-w-0">
            <p class="card-title">Total exécuté</p>
            <p class="tnum text-[22px] font-extrabold mt-1.5 leading-none break-words">15 432,39 €</p>
            <p class="text-xs text-ink-3 mt-1.5">22 virements</p>
        </div>
    </div>
    <div class="stat-tile">
        <span class="stat-icon stat-icon--tint"
            ><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8" />
                <path
                    d="M12 7.2V12l3.1 2"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                /></svg
        ></span>
        <div class="min-w-0">
            <p class="card-title">En attente</p>
            <p class="tnum text-[22px] font-extrabold mt-1.5 leading-none break-words">1</p>
            <p class="text-xs text-ink-3 mt-1.5">À valider ou en cours</p>
        </div>
    </div>
    <div class="stat-tile">
        <span class="stat-icon stat-icon--tint"
            ><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
                <rect x="3.5" y="5.5" width="17" height="15" rx="2.4" stroke="currentColor" stroke-width="1.8" />
                <path
                    d="M3.5 10h17M8 3.5v4M16 3.5v4"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                /></svg
        ></span>
        <div class="min-w-0">
            <p class="card-title">Programmés</p>
            <p class="tnum text-[22px] font-extrabold mt-1.5 leading-none break-words">1</p>
            <p class="text-xs text-ink-3 mt-1.5">Échéances à venir</p>
        </div>
    </div>
</div>

<form action="#" method="get" class="card p-4 sm:p-5 mb-5">
    <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-[1fr_190px_190px_190px]">
        <div class="relative">
            <label for="transfer-search" class="sr-only">Rechercher un virement</label>
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-ink-4 pointer-events-none"
                ><svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none">
                    <circle cx="11" cy="11" r="6.6" stroke="currentColor" stroke-width="1.8" />
                    <path d="M16 16l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg
            ></span>
            <input
                id="transfer-search"
                type="search"
                name="q"
                placeholder="Bénéficiaire, IBAN, référence, motif..."
                class="w-full h-11 pl-11 pr-4 rounded-lg border border-line bg-white text-sm placeholder:text-ink-4 focus:outline-none focus:border-nexo-600 transition-colors"
            />
        </div>
        <div>
            <label for="filter-status" class="sr-only">Statut</label
            ><select
                id="filter-status"
                name="status"
                class="w-full h-11 pl-4 pr-9 rounded-lg border border-line bg-white text-sm font-medium focus:outline-none focus:border-nexo-600 transition-colors"
            >
                <option value="">Tous les statuts</option>
                <option value="executed">Exécutés</option>
                <option value="pending">En attente</option>
                <option value="scheduled">Programmés</option>
                <option value="rejected">Rejetés</option>
            </select>
        </div>
        <div>
            <label for="filter-type" class="sr-only">Type</label
            ><select
                id="filter-type"
                name="type"
                class="w-full h-11 pl-4 pr-9 rounded-lg border border-line bg-white text-sm font-medium focus:outline-none focus:border-nexo-600 transition-colors"
            >
                <option value="">Tous les types</option>
                <option value="immediate">Immédiats</option>
                <option value="scheduled">Différés</option>
                <option value="recurring">Récurrents</option>
            </select>
        </div>
        <div>
            <label for="filter-period" class="sr-only">Période</label
            ><select
                id="filter-period"
                name="period"
                class="w-full h-11 pl-4 pr-9 rounded-lg border border-line bg-white text-sm font-medium focus:outline-none focus:border-nexo-600 transition-colors"
            >
                <option value="">Toute la période</option>
                <option value="7">7 derniers jours</option>
                <option value="30">30 derniers jours</option>
                <option value="90">90 derniers jours</option>
                <option value="365">12 derniers mois</option>
            </select>
        </div>
    </div>
    <div class="flex flex-wrap items-center gap-4 mt-3">
        <button type="submit" class="btn-primary h-10 text-sm">Filtrer</button>
    </div>
</form>

