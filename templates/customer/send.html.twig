/* ------------------------------------------------------------------ *
 *  Overlay de progression
 * ------------------------------------------------------------------ */

/**
 * Affiche l'écran d'attente, déroule les étapes, puis soumet réellement
 * le formulaire — le serveur enregistre l'ordre et redirige vers la page
 * de saisie du code.
 *
 * IMPORTANT : ce minuteur est de l'habillage. Il ne prouve rien et ne
 * sécurise rien. C'est la réponse du serveur qui décide si l'ordre est
 * accepté et si un code doit être envoyé.
 */
function initTransferProgress() {
    const form = document.querySelector('[data-transfer-form]');
    const overlay = document.getElementById('transfer-progress-overlay');

    if (!form || !overlay) return;

    const fill = overlay.querySelector('[data-progress-fill]');
    const percentLabel = overlay.querySelector('[data-progress-percent]');
    const remainingLabel = overlay.querySelector('[data-progress-remaining]');
    const steps = Array.from(overlay.querySelectorAll('[data-progress-step]'));
    const cancelButton = overlay.querySelector('[data-progress-cancel]');

    // Durée totale, pilotée depuis le gabarit pour rester ajustable.
    const duration = Number(overlay.dataset.duration || 60) * 1000;

    let startedAt = null;
    let frame = null;
    let cancelled = false;

    function renderSteps(ratio) {
        const index = Math.min(steps.length - 1, Math.floor(ratio * steps.length));

        steps.forEach((step, i) => {
            step.classList.toggle('is-done', i < index);
            step.classList.toggle('is-current', i === index);
        });
    }

    function tick(now) {
        if (cancelled) return;

        if (startedAt === null) startedAt = now;

        const elapsed = now - startedAt;
        const ratio = Math.min(1, elapsed / duration);

        // On plafonne l'affichage à 99 % : passer à 100 % avant la réponse
        // du serveur laisserait croire que l'opération est terminée.
        const percent = Math.min(99, Math.round(ratio * 100));

        fill.style.width = `${percent}%`;
        overlay.querySelector('[role="progressbar"]')?.setAttribute('aria-valuenow', String(percent));
        if (percentLabel) percentLabel.textContent = `${percent} %`;

        if (remainingLabel) {
            const remaining = Math.max(0, Math.ceil((duration - elapsed) / 1000));
            remainingLabel.textContent = remaining > 0
                ? `Environ ${remaining} seconde${remaining > 1 ? 's' : ''} restantes`
                : 'Finalisation…';
        }

        renderSteps(ratio);

        if (ratio < 1) {
            frame = requestAnimationFrame(tick);
            return;
        }

        // Soumission réelle : le serveur crée l'ordre en attente,
        // envoie le code et redirige vers la page de validation.
        form.submit();
    }

    function open() {
        cancelled = false;
        startedAt = null;
        overlay.hidden = false;
        document.body.classList.add('overflow-hidden');
        renderSteps(0);
        frame = requestAnimationFrame(tick);
    }

    function cancel() {
        cancelled = true;
        if (frame) cancelAnimationFrame(frame);

        overlay.hidden = true;
        document.body.classList.remove('overflow-hidden');

        // Le bouton avait été désactivé à la soumission : on le réactive,
        // sinon l'utilisateur se retrouve avec un formulaire inutilisable.
        const submit = form.querySelector('[data-transfer-submit]');
        if (submit) {
            submit.disabled = false;
            delete submit.dataset.busy;
        }
    }

    cancelButton?.addEventListener('click', cancel);

    // Priorité basse : les validations métier (montant, solde) tournent déjà
    // sur 'submit'. On n'ouvre l'écran d'attente que si rien ne les a bloquées.
    form.addEventListener('submit', (event) => {
        if (event.defaultPrevented) return;

        event.preventDefault();
        open();
    });
}

/* ------------------------------------------------------------------ *
 *  Saisie du code à usage unique
 * ------------------------------------------------------------------ */

function initOtpInput() {
    const container = document.querySelector('[data-otp]');
    if (!container) return;

    const inputs = Array.from(container.querySelectorAll('[data-otp-digit]'));
    const form = container.closest('form');

    // Le champ caché et le bouton vivent dans le formulaire, PAS dans le
    // fieldset qui porte data-otp : on remonte au formulaire pour les
    // retrouver. Les chercher dans le conteneur renverrait null, et le code
    // consolidé ne serait jamais transmis au serveur.
    const scope = form ?? document;
    const hidden = scope.querySelector('[data-otp-value]');
    const submit = scope.querySelector('[data-otp-submit]');

    if (inputs.length === 0) return;

    function value() {
        return inputs.map((input) => input.value).join('');
    }

    function sync() {
        const code = value();
        if (hidden) hidden.value = code;
        if (submit) submit.disabled = code.length !== inputs.length;

        inputs.forEach((input) => {
            input.classList.toggle('is-filled', input.value !== '');
            input.classList.remove('is-invalid');
        });
    }

    inputs.forEach((input, index) => {
        input.addEventListener('input', () => {
            // On ne garde que le dernier chiffre saisi : sur mobile, le clavier
            // peut envoyer plusieurs caractères d'un coup.
            const digits = input.value.replace(/\D/g, '');
            input.value = digits.slice(-1);

            if (input.value && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }

            sync();
        });

        input.addEventListener('keydown', (event) => {
            if (event.key === 'Backspace' && !input.value && index > 0) {
                // Reculer sur une case vide efface la précédente : comportement
                // attendu, sinon l'utilisateur doit cliquer case par case.
                event.preventDefault();
                inputs[index - 1].value = '';
                inputs[index - 1].focus();
                sync();
                return;
            }

            if (event.key === 'ArrowLeft' && index > 0) {
                event.preventDefault();
                inputs[index - 1].focus();
            }

            if (event.key === 'ArrowRight' && index < inputs.length - 1) {
                event.preventDefault();
                inputs[index + 1].focus();
            }
        });

        // Coller un code reçu par SMS doit remplir toutes les cases.
        input.addEventListener('paste', (event) => {
            event.preventDefault();

            const pasted = (event.clipboardData || window.clipboardData)
                .getData('text')
                .replace(/\D/g, '')
                .slice(0, inputs.length);

            if (!pasted) return;

            pasted.split('').forEach((digit, i) => {
                if (inputs[i]) inputs[i].value = digit;
            });

            inputs[Math.min(pasted.length, inputs.length - 1)].focus();
            sync();
        });
    });

    sync();
    inputs[0].focus();
}

/* ------------------------------------------------------------------ *
 *  Compte à rebours de validité du code
 * ------------------------------------------------------------------ */

function initOtpCountdown() {
    const el = document.querySelector('[data-otp-countdown]');
    if (!el) return;

    const resend = document.querySelector('[data-otp-resend]');
    let remaining = Number(el.dataset.otpCountdown || 300);

    function render() {
        const minutes = Math.floor(remaining / 60);
        const seconds = remaining % 60;

        el.textContent = `${minutes}:${String(seconds).padStart(2, '0')}`;

        if (remaining <= 0) {
            el.textContent = 'expiré';
            el.classList.add('text-debit-fg');

            // Le code n'est plus valable : on invite explicitement à en
            // redemander un plutôt que de laisser l'utilisateur saisir dans le vide.
            document.querySelectorAll('[data-otp-digit]').forEach((input) => {
                input.disabled = true;
            });

            const submit = document.querySelector('[data-otp-submit]');
            if (submit) submit.disabled = true;

            if (resend) resend.disabled = false;

            const expired = document.querySelector('[data-otp-expired]');
            if (expired) expired.hidden = false;

            return;
        }

        remaining -= 1;
        setTimeout(render, 1000);
    }

    render();
}

/* ------------------------------------------------------------------ *
 *  Détail d'un virement
 * ------------------------------------------------------------------ */

function initTransferDetail() {
    const modal = document.getElementById('transfer-detail-modal');
    if (!modal) return;

    modal.addEventListener('modal:open', (event) => {
        const trigger = event.detail?.trigger;
        if (!trigger) return;

        const d = trigger.dataset;

        const set = (key, value) => {
            modal.querySelectorAll(`[data-t-field="${key}"]`).forEach((el) => {
                el.textContent = value || '—';
            });
        };

        ['reference', 'date', 'beneficiary', 'iban', 'initials', 'account',
         'amount', 'reason', 'type'].forEach((key) => {
            // dataset transforme data-t-reference en tReference.
            set(key, d[`t${key.charAt(0).toUpperCase()}${key.slice(1)}`]);
        });

        // Le badge change de couleur selon le statut : on remplace la classe
        // entière plutôt que d'empiler les variantes au fil des ouvertures.
        const badge = modal.querySelector('[data-t-badge]');
        if (badge) {
            badge.className = `${d.tStatusClass || 'badge-neutral'} mt-3 inline-block`;
            badge.textContent = d.tStatus || '—';
        }

        // Un virement rejeté ou encore programmé n'a pas de justificatif.
        const receipt = modal.querySelector('[data-t-receipt]');
        if (receipt) {
            const url = d.tReceipt || '';
            receipt.hidden = url === '';
            if (url) receipt.href = url;
        }
    });
}

