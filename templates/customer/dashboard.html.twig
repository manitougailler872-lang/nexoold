  // ----- Crypto (widget + marchés + portefeuille détaillé) — données réelles CoinGecko -----
  function miniSpark(prices, color){
    if(!prices || prices.length < 2) return '';
    const w = 70, h = 28, pad = 2;
    const min = Math.min(...prices), max = Math.max(...prices);
    const range = (max - min) || 1;
    const step = (w - pad*2) / (prices.length - 1);
    const pts = prices.map((p,i) => {
      const x = pad + i*step;
      const y = pad + (h - pad*2) * (1 - (p - min)/range);
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    }).join(' ');
    return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}"><polyline points="${pts}" fill="none" stroke="${color}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
  }

  // Quantités détenues — données de démonstration (à brancher sur le portefeuille réel de l'utilisateur)
  const CRYPTO_HOLDINGS = {
    bitcoin: 0.042,
    ethereum: 0.85,
    solana: 12,
    tether: 500,
    ripple: 800
  };
  const CRYPTO_IDS = Object.keys(CRYPTO_HOLDINGS).join(',');
  const CRYPTO_COLORS = { bitcoin: '#F7931A', ethereum: '#627EEA', solana: '#14F195', tether: '#26A17B', ripple: '#0B0B0B' };

  function fmtEUR(n){ return n.toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }

  async function loadCryptoOverview(){
    try{
      const res = await fetch(`https://api.coingecko.com/api/v3/coins/markets?vs_currency=eur&ids=${CRYPTO_IDS}&order=market_cap_desc&sparkline=true&price_change_percentage=24h`);
      const data = await res.json();

      // ----- Résumé compact (widget dans la grille 2 colonnes) -----
      let total = 0;
      data.forEach(c => { total += (CRYPTO_HOLDINGS[c.id] || 0) * c.current_price; });
      const globalUp = data.reduce((s,c) => s + (c.price_change_percentage_24h||0), 0) / data.length >= 0;

      // ----- Tableau détaillé (section pleine largeur) -----

      // ----- Widget Marchés (réutilise les mêmes données) -----
      document.getElementById('marketsCryptoRows').innerHTML = data.map(c => {
        const up = c.price_change_percentage_24h >= 0;
        const spark = c.sparkline_in_7d ? c.sparkline_in_7d.price.slice(-30) : [];
        return `<div class="flex items-center justify-between">
          <div class="flex items-center gap-3"><div class="w-8 h-8 rounded-lg bg-panel flex items-center justify-center overflow-hidden"><img src="${c.image}" class="w-5 h-5" alt="${c.symbol}"></div><span class="font-medium text-[13.5px] uppercase">${c.symbol}</span></div>
          ${miniSpark(spark, up ? '#16A34A' : '#DC2626').replace('width="70" height="28"','width="60" height="24"')}
          <span class="font-mono text-[13px] ${up?'text-up':'text-down'}">${up?'+':''}${(c.price_change_percentage_24h||0).toFixed(2)}%</span>
        </div>`;
      }).join('');
    }catch(e){
      document.getElementById('cryptoOvList').innerHTML = '<div class="text-center text-muted text-[13px] py-4">Données de marché momentanément indisponibles.</div>';
      document.getElementById('cryptoHoldingsTable').innerHTML = '<tr><td colspan="5" class="text-center text-muted text-sm py-8">Données momentanément indisponibles.</td></tr>';
      document.getElementById('cryptoOvUpdate').textContent = '';
    }
  }
  loadCryptoOverview();
  setInterval(loadCryptoOverview, 60000);
    </script>
    
