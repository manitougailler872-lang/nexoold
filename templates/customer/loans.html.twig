{% block javascripts %}
<script>
(function(){
/* ---------- Tiroir de navigation (mobile) ---------- */
(function () {
  const sidebar = document.querySelector('[data-sidebar]');
  const overlay = document.querySelector('[data-sidebar-overlay]');
  const toggles = document.querySelectorAll('[data-sidebar-toggle]');
  const closers = document.querySelectorAll('[data-sidebar-close]');
  if (!sidebar) return;
  const OPEN = '-translate-x-full';
  const isMobile = () => (window.matchMedia ? window.matchMedia('(max-width: 1023px)').matches : window.innerWidth <= 1023);
  const isOpen = () => !sidebar.classList.contains(OPEN);
  function open() {
    sidebar.classList.remove(OPEN);
    overlay && overlay.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    toggles.forEach(t => t.setAttribute('aria-expanded', 'true'));
  }
  function close() {
    sidebar.classList.add(OPEN);
    overlay && overlay.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
    toggles.forEach(t => t.setAttribute('aria-expanded', 'false'));
  }
  toggles.forEach(t => { t.setAttribute('aria-expanded','false');
    t.addEventListener('click', e => { e.stopPropagation(); isOpen() ? close() : open(); }); });
  closers.forEach(c => c.addEventListener('click', close));
  overlay && overlay.addEventListener('click', close);
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && isMobile() && isOpen()) close(); });
  sidebar.querySelectorAll('a[href]').forEach(l => l.addEventListener('click', () => { if (isMobile()) close(); }));
  window.addEventListener('resize', () => { if (!isMobile()) { overlay && overlay.classList.add('hidden'); document.body.classList.remove('overflow-hidden'); }});
})();

/* ---------- Menus déroulants ---------- */
(function () {
  const roots = Array.from(document.querySelectorAll('[data-dropdown]'));
  const ctrls = [];
  function closeAll(except) { ctrls.forEach(c => { if (c !== except) c.close(false); }); }
  roots.forEach(root => {
    const trigger = root.querySelector('[data-dropdown-trigger]');
    const panel = root.querySelector('[data-dropdown-panel]');
    if (!trigger || !panel) return;
    const c = {
      isOpen: () => !panel.hidden,
      open() {
        closeAll(c); panel.hidden = false; root.classList.add('is-open');
        trigger.setAttribute('aria-expanded','true');
        if (window.matchMedia && window.matchMedia('(max-width: 639px)').matches) document.body.classList.add('overflow-hidden');
      },
      close(returnFocus = true) {
        if (panel.hidden) return;
        panel.hidden = true; root.classList.remove('is-open');
        trigger.setAttribute('aria-expanded','false');
        document.body.classList.remove('overflow-hidden');
        if (returnFocus) trigger.focus();
      },
      toggle() { c.isOpen() ? c.close() : c.open(); }
    };
    panel.hidden = true;
    trigger.setAttribute('aria-expanded','false');
    trigger.setAttribute('aria-haspopup','true');
    trigger.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); c.toggle(); });
    panel.addEventListener('click', e => {
      if (e.target.closest('[data-dropdown-close]')) { c.close(); return; }
      e.stopPropagation();
    });
    ctrls.push(c);
  });
  document.addEventListener('click', () => closeAll(null));
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    const open = ctrls.find(c => c.isOpen());
    if (open) open.close();
  });
})();


/* ===== Modales ===== */
/**
 * Fenêtres modales.
 *
 * Balisage attendu :
 *   <button data-modal-open="id-de-la-modale">…</button>
 *   <div id="id-de-la-modale" class="modal" hidden role="dialog" aria-modal="true">
 *       <div class="modal-backdrop" data-modal-close></div>
 *       <div class="modal-panel">… <button data-modal-close>…</button></div>
 *   </div>
 *
 * Accessibilité :
 *  - le focus est piégé dans la boîte tant qu'elle est ouverte ;
 *  - Échap et le clic sur le voile referment ;
 *  - le focus revient sur l'élément déclencheur à la fermeture ;
 *  - le défilement de la page est bloqué derrière la modale.
 */

const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

let opener = null;

function openModal(modal, trigger = null) {
    if (!modal) return;

    opener = trigger;
    modal.hidden = false;
    document.body.classList.add('overflow-hidden');

    const first = modal.querySelector('[data-modal-autofocus]') || modal.querySelector(FOCUSABLE);
    first?.focus?.();

    modal.dispatchEvent(new CustomEvent('modal:open', { detail: { trigger } }));
}

function closeModal(modal) {
    if (!modal || modal.hidden) return;

    modal.hidden = true;
    document.body.classList.remove('overflow-hidden');

    opener?.focus();
    opener = null;

    modal.dispatchEvent(new CustomEvent('modal:close'));
}

function currentOpen() {
    return document.querySelector('.modal:not([hidden])');
}

function initModals() {
    document.querySelectorAll('[data-modal-open]').forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
            event.preventDefault();
            openModal(document.getElementById(trigger.dataset.modalOpen), trigger);
        });
    });

    document.addEventListener('click', (event) => {
        const closer = event.target.closest('[data-modal-close]');
        if (closer) closeModal(closer.closest('.modal'));
    });

    document.addEventListener('keydown', (event) => {
        const modal = currentOpen();
        if (!modal) return;

        if (event.key === 'Escape') {
            closeModal(modal);
            return;
        }

        // Piège à focus : Tab ne doit pas sortir de la boîte de dialogue.
        if (event.key !== 'Tab') return;

        const items = Array.from(modal.querySelectorAll(FOCUSABLE))
            .filter((el) => el.offsetParent !== null);

        if (items.length === 0) return;

        const first = items[0];
        const last = items[items.length - 1];

        if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
        }
    });
}

/* ===== Bénéficiaires ===== */

/* ------------------------------------------------------------------ *
 *  Validation IBAN — contrôle mod 97 (norme ISO 13616)
 * ------------------------------------------------------------------ */

/**
 * Le mod 97 rattrape la quasi-totalité des fautes de frappe et des
 * interversions de chiffres. Le faire côté client évite un aller-retour
 * serveur pour une erreur de saisie — mais il ne remplace PAS la contrainte
 * Assert\Iban côté Symfony : tout ce qui vient du navigateur est falsifiable.
 */
function isValidIban(raw) {
    const iban = String(raw).replace(/\s+/g, '').toUpperCase();

    if (!/^[A-Z]{2}\d{2}[A-Z0-9]{10,30}$/.test(iban)) return false;

    // Les 4 premiers caractères passent à la fin, les lettres deviennent
    // des nombres (A=10 … Z=35), puis on vérifie que le reste vaut 1.
    const rearranged = iban.slice(4) + iban.slice(0, 4);
    const digits = rearranged.replace(/[A-Z]/g, (c) => c.charCodeAt(0) - 55);

    // Division par tranches : le nombre dépasse la précision d'un Number.
    let remainder = 0;
    for (const digit of digits) {
        remainder = (remainder * 10 + Number(digit)) % 97;
    }

    return remainder === 1;
}

const isValidBic = (raw) => /^[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3})?$/.test(String(raw).replace(/\s+/g, '').toUpperCase());

const formatIban = (raw) => String(raw).replace(/\s+/g, '').toUpperCase().replace(/(.{4})/g, '$1 ').trim();

/* ------------------------------------------------------------------ *
 *  Menus d'action : visualiser / éditer / supprimer
 * ------------------------------------------------------------------ */

function initBeneficiaryActions() {
    // --- Visualiser ---
    const viewModal = document.getElementById('beneficiary-view-modal');

    document.querySelectorAll('[data-beneficiary-view]').forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
            event.preventDefault();
            if (!viewModal) return;

            const d = trigger.dataset;
            const set = (key, value) => {
                const el = viewModal.querySelector(`[data-field="${key}"]`);
                if (el) el.textContent = value || '—';
            };

            set('name', d.bName);
            set('iban', d.bIban);
            set('bic', d.bBic);
            set('bank', d.bBank);
            set('country', d.bCountry);
            set('status', d.bStatus);
            set('created', d.bCreated);

            const editLink = viewModal.querySelector('[data-action="edit"]');
            if (editLink && d.bEditUrl) editLink.href = d.bEditUrl;

            openModal(viewModal, trigger);
        });
    });

    // --- Supprimer ---
    const deleteModal = document.getElementById('beneficiary-delete-modal');

    document.querySelectorAll('[data-beneficiary-delete]').forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
            event.preventDefault();
            if (!deleteModal) return;

            const d = trigger.dataset;
            const nameEl = deleteModal.querySelector('[data-field="name"]');
            const ibanEl = deleteModal.querySelector('[data-field="iban"]');
            const form = deleteModal.querySelector('form');

            if (nameEl) nameEl.textContent = d.bName || '';
            if (ibanEl) ibanEl.textContent = d.bIban || '';

            if (form) {
                // L'URL et le jeton viennent du serveur, portés par le
                // déclencheur : le JS ne fabrique aucune URL de suppression.
                form.action = d.bDeleteUrl || '';
                const token = form.querySelector('input[name="_token"]');
                if (token) token.value = d.bToken || '';
            }

            openModal(deleteModal, trigger);
        });
    });
}

/* ------------------------------------------------------------------ *
 *  Assistant d'ajout : pays → banque → informations → récapitulatif
 * ------------------------------------------------------------------ */

function initBeneficiaryWizard() {
    const modal = document.getElementById('beneficiary-add-modal');
    if (!modal) return;

    const form = modal.querySelector('form');
    const steps = Array.from(modal.querySelectorAll('[data-step]'));
    const dots = Array.from(modal.querySelectorAll('[data-step-dot]'));
    const bars = Array.from(modal.querySelectorAll('[data-step-bar]'));
    const btnBack = modal.querySelector('[data-wizard-back]');
    const btnNext = modal.querySelector('[data-wizard-next]');
    const btnSubmit = modal.querySelector('[data-wizard-submit]');

    let banks = [];
    try {
        banks = JSON.parse(modal.dataset.banks || '[]');
    } catch (e) {
        console.error('Liste des banques illisible', e);
    }

    let current = 1;
    const total = steps.length;

    /*
       Accès aux champs par sélecteur explicite, jamais par `form.nomDuChamp`.

       L'accès nommé est shadowé par les propriétés natives de HTMLFormElement
       (action, method, target, submit, reset, length, name…) : un champ appelé
       « action » renverrait l'URL du formulaire au lieu de l'input, sans la
       moindre erreur. Certaines implémentations ne l'exposent d'ailleurs pas
       du tout.
    */
    const field = (name) => form.querySelector(`[name="${name}"]`);

    /* ---------- Navigation ---------- */

    function render() {
        steps.forEach((s) => {
            s.hidden = Number(s.dataset.step) !== current;
        });

        dots.forEach((dot) => {
            const n = Number(dot.dataset.stepDot);
            dot.classList.toggle('is-current', n === current);
            dot.classList.toggle('is-done', n < current);
        });

        bars.forEach((bar) => {
            bar.classList.toggle('is-done', Number(bar.dataset.stepBar) < current);
        });

        btnBack.hidden = current === 1;
        btnNext.hidden = current === total;
        btnSubmit.hidden = current !== total;

        // Optionnel : certains environnements de test n'implémentent pas scrollTo.
        modal.querySelector('.modal-body')?.scrollTo?.({ top: 0 });
    }

    function go(step) {
        current = Math.max(1, Math.min(step, total));
        if (current === total) buildRecap();
        render();
    }

    /* ---------- Étape 1 : pays ---------- */

    function selectedCountry() {
        return form.querySelector('input[name="country"]:checked');
    }

    form.querySelectorAll('input[name="country"]').forEach((radio) => {
        radio.addEventListener('change', () => {
            renderBanks(radio.value);
            // Changer de pays invalide la banque déjà choisie.
            form.querySelectorAll('input[name="bank"]').forEach((b) => { b.checked = false; });
        });
    });

    /* ---------- Étape 2 : banque ---------- */

    const bankList = modal.querySelector('[data-bank-list]');
    const bankEmpty = modal.querySelector('[data-bank-empty]');

    function renderBanks(countryCode) {
        if (!bankList) return;

        const matches = banks.filter((b) => b.country === countryCode);
        bankList.innerHTML = '';

        if (matches.length === 0) {
            bankList.hidden = true;
            if (bankEmpty) bankEmpty.hidden = false;
            return;
        }

        bankList.hidden = false;
        if (bankEmpty) bankEmpty.hidden = true;

        matches.forEach((bank, index) => {
            const id = `bank-${countryCode}-${index}`;
            const wrapper = document.createElement('div');

            wrapper.innerHTML = `
                <input type="radio" name="bank" id="${id}" class="peer sr-only"
                       value="" data-bic="" data-prefix="">
                <label for="${id}" class="choice-card">
                    <span class="bank-logo" style="background-color: ${bank.color}"></span>
                    <span class="min-w-0">
                        <span class="block text-sm font-bold"></span>
                        <span class="block text-xs text-ink-3 tnum mt-0.5"></span>
                    </span>
                </label>`;

            // Les valeurs passent par des propriétés, jamais par interpolation
            // HTML : un nom de banque contenant une apostrophe casserait le
            // balisage, et un champ non assaini ouvrirait une injection.
            const input = wrapper.querySelector('input');
            input.value = bank.name;
            input.dataset.bic = bank.bic || '';
            input.dataset.prefix = bank.prefix || '';

            const [nameEl, bicEl] = wrapper.querySelectorAll('label span.min-w-0 > span');
            nameEl.textContent = bank.name;
            bicEl.textContent = bank.bic ? `BIC ${bank.bic}` : '';
            wrapper.querySelector('.bank-logo').textContent = bank.short;

            input.addEventListener('change', () => {
                const bicField = field('bic');
                if (bicField && !bicField.value) bicField.value = input.dataset.bic;
            });

            bankList.appendChild(wrapper);
        });
    }

    /* ---------- Étape 3 : validation des champs ---------- */

    function showError(field, message) {
        const input = form.querySelector(`[name="${field}"]`);
        const error = form.querySelector(`[data-error="${field}"]`);

        input?.classList.toggle('is-invalid', Boolean(message));
        if (error) {
            error.textContent = message || '';
            error.hidden = !message;
        }
        if (input) input.setAttribute('aria-invalid', message ? 'true' : 'false');
    }

    function validateStep(step) {
        if (step === 1) {
            const ok = Boolean(selectedCountry());
            toggleStepMessage(1, ok ? '' : 'Choisissez un pays pour continuer.');
            return ok;
        }

        if (step === 2) {
            const ok = Boolean(form.querySelector('input[name="bank"]:checked'));
            toggleStepMessage(2, ok ? '' : 'Choisissez une banque pour continuer.');
            return ok;
        }

        if (step === 3) {
            let ok = true;

            const firstname = field('firstname').value.trim();
            const lastname = field('lastname').value.trim();
            const iban = field('iban').value.trim();
            const bic = field('bic').value.trim();

            showError('firstname', firstname ? '' : 'Le prénom est obligatoire.');
            if (!firstname) ok = false;

            showError('lastname', lastname ? '' : 'Le nom est obligatoire.');
            if (!lastname) ok = false;

            if (!iban) {
                showError('iban', "L'IBAN est obligatoire.");
                ok = false;
            } else if (!isValidIban(iban)) {
                showError('iban', "Cet IBAN est invalide (clé de contrôle incorrecte).");
                ok = false;
            } else {
                const country = selectedCountry()?.value;
                const prefix = iban.replace(/\s+/g, '').slice(0, 2).toUpperCase();

                // Un IBAN allemand sur un bénéficiaire déclaré en France est
                // presque toujours une erreur de saisie : on le signale avant
                // que le virement ne parte.
                if (country && prefix !== country) {
                    showError('iban', `Cet IBAN commence par ${prefix}, mais le pays choisi est ${country}.`);
                    ok = false;
                } else {
                    showError('iban', '');
                    field('iban').value = formatIban(iban);
                }
            }

            if (bic && !isValidBic(bic)) {
                showError('bic', 'Le BIC doit comporter 8 ou 11 caractères.');
                ok = false;
            } else {
                showError('bic', '');
            }

            return ok;
        }

        return true;
    }

    function toggleStepMessage(step, message) {
        const el = modal.querySelector(`[data-step-error="${step}"]`);
        if (!el) return;
        el.textContent = message;
        el.hidden = !message;
    }

    /* ---------- Étape 4 : récapitulatif ---------- */

    function buildRecap() {
        const country = selectedCountry();
        const bank = form.querySelector('input[name="bank"]:checked');

        const values = {
            country: country?.dataset.label || '—',
            bank: bank?.value || '—',
            name: `${field('firstname').value.trim()} ${field('lastname').value.trim()}`.trim() || '—',
            iban: field('iban').value.trim() || '—',
            bic: field('bic').value.trim().toUpperCase() || '—',
            label: field('label').value.trim() || '—',
        };

        Object.entries(values).forEach(([key, value]) => {
            const el = modal.querySelector(`[data-recap="${key}"]`);
            if (el) el.textContent = value;
        });
    }

    /* ---------- Écouteurs ---------- */

    btnNext.addEventListener('click', () => {
        if (validateStep(current)) go(current + 1);
    });

    btnBack.addEventListener('click', () => go(current - 1));

    form.addEventListener('submit', (event) => {
        // Dernier filet : on revalide tout avant l'envoi, au cas où
        // l'utilisateur serait revenu en arrière modifier un champ.
        for (let step = 1; step < total; step += 1) {
            if (!validateStep(step)) {
                event.preventDefault();
                go(step);
                return;
            }
        }
    });

    // Réinitialisation à chaque ouverture : sans cela, un abandon laisserait
    // les champs de la tentative précédente au rouvrant.
    modal.addEventListener('modal:open', () => {
        form.reset();
        ['firstname', 'lastname', 'iban', 'bic'].forEach((f) => showError(f, ''));
        [1, 2].forEach((s) => toggleStepMessage(s, ''));
        if (bankList) bankList.innerHTML = '';
        if (bankEmpty) bankEmpty.hidden = false;
        go(1);
    });

    modal.querySelectorAll('[data-wizard-cancel]').forEach((btn) => {
        btn.addEventListener('click', () => closeModal(modal));
    });

    render();
}

initModals();
initBeneficiaryActions();
initBeneficiaryWizard();


/* ------------------------------------------------------------------ *
 *  Pavé de signature
 * ------------------------------------------------------------------ */

/**
 * Signature manuscrite sur <canvas>.
 *
 * Choix techniques :
 *  - Pointer Events plutôt que mouse + touch : un seul jeu d'écouteurs couvre
 *    souris, trackpad, doigt et stylet.
 *  - `setPointerCapture` : le tracé continue proprement si le doigt sort du
 *    canvas, au lieu de s'interrompre net.
 *  - `touch-action: none` (classe CSS) : sans lui, le navigateur mobile fait
 *    défiler la page au lieu de dessiner.
 *  - Le canvas est dimensionné en pixels physiques (devicePixelRatio), sinon
 *    le tracé est flou sur écran à haute densité.
 */
function createSignaturePad(root) {
    const canvas = root.querySelector('canvas');
    if (!canvas) return null;

    const ctx = canvas.getContext('2d');
    let drawing = false;
    let empty = true;
    let lastX = 0;
    let lastY = 0;

    function applySize() {
        const ratio = window.devicePixelRatio || 1;
        const rect = canvas.getBoundingClientRect();

        // Un redimensionnement vide le canvas : on sauvegarde le tracé courant
        // pour le restituer ensuite.
        const previous = empty ? null : canvas.toDataURL();

        canvas.width = Math.max(1, Math.round(rect.width * ratio));
        canvas.height = Math.max(1, Math.round(rect.height * ratio));

        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        ctx.lineWidth = 2.2;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.strokeStyle = '#0F1A16';

        if (previous) {
            const image = new Image();
            image.onload = () => ctx.drawImage(image, 0, 0, rect.width, rect.height);
            image.src = previous;
        }
    }

    function position(event) {
        const rect = canvas.getBoundingClientRect();
        return { x: event.clientX - rect.left, y: event.clientY - rect.top };
    }

    function start(event) {
        // Seul le bouton principal dessine : un clic droit ne doit rien tracer.
        if (event.button !== undefined && event.button !== 0) return;

        drawing = true;
        canvas.setPointerCapture?.(event.pointerId);

        const { x, y } = position(event);
        lastX = x;
        lastY = y;

        // Un simple point doit laisser une marque.
        ctx.beginPath();
        ctx.arc(x, y, ctx.lineWidth / 2, 0, Math.PI * 2);
        ctx.fillStyle = ctx.strokeStyle;
        ctx.fill();

        markSigned();
        event.preventDefault();
    }

    function move(event) {
        if (!drawing) return;

        const { x, y } = position(event);

        ctx.beginPath();
        ctx.moveTo(lastX, lastY);
        ctx.lineTo(x, y);
        ctx.stroke();

        lastX = x;
        lastY = y;
        event.preventDefault();
    }

    function stop(event) {
        if (!drawing) return;
        drawing = false;
        canvas.releasePointerCapture?.(event.pointerId);
    }

    function markSigned() {
        empty = false;
        root.classList.add('is-signed');
        root.dispatchEvent(new CustomEvent('signature:change', { bubbles: true }));
    }

    canvas.addEventListener('pointerdown', start);
    canvas.addEventListener('pointermove', move);
    canvas.addEventListener('pointerup', stop);
    canvas.addEventListener('pointercancel', stop);
    canvas.addEventListener('pointerleave', stop);

    window.addEventListener('resize', applySize);
    applySize();

    return {
        isEmpty: () => empty,

        clear() {
            ctx.save();
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.restore();

            empty = true;
            root.classList.remove('is-signed');
            root.dispatchEvent(new CustomEvent('signature:change', { bubbles: true }));
        },

        /** @returns {string} PNG encodé en base64, ou '' si rien n'est tracé. */
        toDataUrl: () => (empty ? '' : canvas.toDataURL('image/png')),

        resize: applySize,
    };
}

/* ------------------------------------------------------------------ *
 *  Modale de signature de contrat — 3 étapes
 * ------------------------------------------------------------------ */

function initSignatureModal() {
    const modal = document.getElementById('loan-signature-modal');
    if (!modal) return;

    const form = modal.querySelector('form');
    const steps = Array.from(modal.querySelectorAll('[data-sign-step]'));
    const dots = Array.from(modal.querySelectorAll('[data-sign-dot]'));
    const bars = Array.from(modal.querySelectorAll('[data-sign-bar]'));

    const btnBack = modal.querySelector('[data-sign-back]');
    const btnNext = modal.querySelector('[data-sign-next]');
    const btnSign = modal.querySelector('[data-sign-validate]');
    const btnFinish = modal.querySelector('[data-sign-finish]');
    const btnClear = modal.querySelector('[data-sign-clear]');

    const padRoot = modal.querySelector('.signature-pad');
    const pad = padRoot ? createSignaturePad(padRoot) : null;

    const accept = form.querySelector('[name="acceptTerms"]');
    const typedName = form.querySelector('[name="typedSignature"]');
    const signatureField = form.querySelector('[name="signature"]');

    const total = steps.length;
    let current = 1;

    /** Une signature vaut si le pavé est tracé OU si le nom est saisi. */
    function hasSignature() {
        const drawn = pad && !pad.isEmpty();
        const typed = typedName && typedName.value.trim().length >= 3;
        return Boolean(drawn || typed);
    }

    function message(step, text) {
        const el = modal.querySelector(`[data-sign-error="${step}"]`);
        if (!el) return;
        el.textContent = text || '';
        el.hidden = !text;
    }

    function render() {
        steps.forEach((s) => { s.hidden = Number(s.dataset.signStep) !== current; });

        dots.forEach((dot) => {
            const n = Number(dot.dataset.signDot);
            dot.classList.toggle('is-current', n === current);
            dot.classList.toggle('is-done', n < current);
            // L'étape franchie affiche une coche à la place du numéro.
            const check = dot.querySelector('[data-dot-check]');
            const number = dot.querySelector('[data-dot-number]');
            if (check && number) {
                check.hidden = n >= current;
                number.hidden = n < current;
            }
        });

        bars.forEach((bar) => bar.classList.toggle('is-done', Number(bar.dataset.signBar) < current));

        btnBack.hidden = current === 1 || current === total;
        btnNext.hidden = current !== 1;
        btnSign.hidden = current !== 2;
        btnFinish.hidden = current !== total;

        // Le canvas n'a pas de dimensions tant qu'il est masqué : il faut le
        // redimensionner au moment où l'étape 2 devient visible.
        if (current === 2) requestAnimationFrame(() => pad?.resize());
    }

    function go(step) {
        current = Math.max(1, Math.min(step, total));
        render();
    }

    btnNext?.addEventListener('click', () => {
        if (accept && !accept.checked) {
            message(1, 'Vous devez accepter les conditions du contrat pour continuer.');
            return;
        }
        message(1, '');
        go(2);
    });

    btnBack?.addEventListener('click', () => go(current - 1));
    btnClear?.addEventListener('click', () => { pad?.clear(); message(2, ''); });

    padRoot?.addEventListener('signature:change', () => message(2, ''));
    typedName?.addEventListener('input', () => message(2, ''));

    btnSign?.addEventListener('click', () => {
        if (!hasSignature()) {
            message(2, 'Signez dans le cadre ou saisissez votre nom complet.');
            return;
        }

        message(2, '');

        // La signature manuscrite prime ; le nom saisi sert de repli.
        signatureField.value = pad && !pad.isEmpty()
            ? pad.toDataUrl()
            : `typed:${typedName.value.trim()}`;

        const preview = modal.querySelector('[data-signature-preview]');
        if (preview) {
            if (pad && !pad.isEmpty()) {
                preview.innerHTML = '';
                const img = new Image();
                img.src = pad.toDataUrl();
                img.alt = 'Aperçu de votre signature';
                img.className = 'max-h-20 mx-auto';
                preview.appendChild(img);
            } else {
                preview.textContent = typedName.value.trim();
                preview.className = 'text-center text-xl font-semibold italic text-ink';
            }
        }

        go(3);
    });

    modal.querySelectorAll('[data-sign-cancel]').forEach((btn) => {
        btn.addEventListener('click', () => closeModal(modal));
    });

    // Remise à zéro à chaque ouverture : une signature abandonnée ne doit pas
    // resservir pour un autre contrat.
    modal.addEventListener('modal:open', (event) => {
        form.reset();
        pad?.clear();
        signatureField.value = '';
        [1, 2].forEach((s) => message(s, ''));

        const trigger = event.detail?.trigger;
        if (trigger) {
            const set = (key, value) => {
                const el = modal.querySelector(`[data-contract="${key}"]`);
                if (el) el.textContent = value || '—';
            };

            set('type', trigger.dataset.loanType);
            set('reference', trigger.dataset.loanReference);
            set('amount', trigger.dataset.loanAmount);
            set('duration', trigger.dataset.loanDuration);
            set('monthly', trigger.dataset.loanMonthly);
            set('rate', trigger.dataset.loanRate);

            const idField = form.querySelector('[name="loanId"]');
            if (idField) idField.value = trigger.dataset.loanId || '';
            if (trigger.dataset.loanSignUrl) form.action = trigger.dataset.loanSignUrl;
        }

        go(1);
    });

    render();
}

/* ------------------------------------------------------------------ *
 *  Dépliage des demandes
 * ------------------------------------------------------------------ */

function initLoanDetails() {
    document.querySelectorAll('[data-loan-toggle]').forEach((button) => {
        const panel = document.getElementById(button.getAttribute('aria-controls'));
        if (!panel) return;

        const label = button.querySelector('[data-toggle-label]');

        button.addEventListener('click', () => {
            const open = panel.hidden;

            panel.hidden = !open;
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
            button.querySelector('svg')?.classList.toggle('rotate-180', open);

            // Le libellé suit l'état : « Voir » / « Masquer ».
            if (label) {
                const next = open ? button.dataset.labelOpen : button.dataset.labelClosed;
                if (next) label.textContent = next;
            }

            // À la première ouverture, on amène l'échéancier dans le champ de
            // vision : déplié sous une carte, il passe souvent sous la ligne
            // de flottaison sans que l'utilisateur s'en aperçoive.
            if (open) {
                requestAnimationFrame(() => {
                    panel.scrollIntoView?.({ behavior: 'smooth', block: 'nearest' });
                });
            }
        });
    });
}

/* ------------------------------------------------------------------ *
 *  Modale « Contrat »
 * ------------------------------------------------------------------ */

function initContractModal() {
    const modal = document.getElementById('loan-contract-modal');
    if (!modal) return;

    modal.addEventListener('modal:open', (event) => {
        const trigger = event.detail?.trigger;
        if (!trigger) return;

        const d = trigger.dataset;

        // Plusieurs éléments portent la même clé (référence en en-tête et dans
        // le corps du document) : on les renseigne tous.
        const set = (key, value) => {
            modal.querySelectorAll(`[data-contract="${key}"]`).forEach((el) => {
                el.textContent = value || '—';
            });
        };

        set('type', d.loanType);
        set('reference', d.loanReference);
        set('amount', d.loanAmount);
        set('duration', d.loanDuration);
        set('monthly', d.loanMonthly);
        set('rate', d.loanRate);
        set('cost', d.loanCost);
        set('borrower', d.loanBorrower);
        set('account', d.loanAccount);

        // Bloc signature : renseigné seulement si le contrat est déjà signé.
        const block = modal.querySelector('[data-contract-signature]');
        const empty = modal.querySelector('[data-contract-signature-empty]');

        if (block) {
            block.querySelector('[data-signed-name]')?.remove();

            if (d.loanSigned === '1') {
                if (empty) empty.hidden = true;

                const name = document.createElement('span');
                name.dataset.signedName = 'true';
                name.className = 'text-[15px] font-semibold italic text-ink';
                name.textContent = d.loanBorrower || '';
                block.appendChild(name);
            } else if (empty) {
                empty.hidden = false;
            }
        }

        const download = modal.querySelector('[data-contract-download]');
        if (download && d.loanDownloadUrl) download.href = d.loanDownloadUrl;
    });
}

initSignatureModal();
initLoanDetails();
initContractModal();

})();
