{% extends 'shared/_base.html.twig' %}

{% set statusStyles = {
    'active':   {label: 'Actif',      class: 'badge-credit'},
    'pending':  {label: 'En attente', class: 'badge bg-amber-100 text-amber-700'},
    'refused':  {label: 'Refusé',     class: 'badge-debit'},
    'to_sign':  {label: 'À signer',   class: 'badge bg-blue-100 text-blue-700'}
} %}
{% set loanStyles = {
    'mortgage': {icon: 'home',   bg: 'bg-nexo-50',   fg: 'text-nexo-700'},
    'auto':     {icon: 'car',    bg: 'bg-blue-50',   fg: 'text-blue-600'},
    'personal': {icon: 'globe',  bg: 'bg-amber-50',  fg: 'text-amber-600'},
    'other':    {icon: 'target', bg: 'bg-pink-50',   fg: 'text-pink-600'}
} %}

{% block content %}
   <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
    <div>
        <h1 class="text-[22px] font-extrabold tracking-tight">Mes demandes de prêt</h1>
        <p class="text-sm text-ink-3 mt-1">
            Suivez le statut de chaque demande, son récapitulatif et son tableau d'amortissement
        </p>
    </div>
    <a href="{{path('app_get_loans')}}" class="btn-primary w-full sm:w-auto justify-center"
        ><svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none">
            <path d="M12 5.5v13M5.5 12h13" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" /></svg
        >Nouvelle demande</a
    >
</div>

<div class="space-y-4">
    <article class="loan-card">
        <div class="flex flex-wrap items-start gap-4">
            <div class="flex items-start gap-3.5 min-w-0 flex-1">
                <span class="loan-icon bg-nexo-50 text-nexo-700"
                    ><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
                        <path
                            d="M4 10.5L12 4l8 6.5V20a1 1 0 01-1 1h-4v-6H9v6H5a1 1 0 01-1-1v-9.5z"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linejoin="round"
                        /></svg
                ></span>
                <div class="min-w-0">
                    <h2 class="text-base font-extrabold break-words">Prêt hypothécaire</h2>
                    <p class="text-xs text-ink-3 mt-1 flex flex-wrap items-center gap-x-2 gap-y-1">
                        <span class="tnum">Demande #NXP-2026-0142</span><span>•</span
                        ><span>Soumise le 3 janv. 2026</span>
                    </p>
                </div>
            </div>
            <div class="grid grid-cols-3 gap-4 sm:gap-8 w-full sm:w-auto order-3 sm:order-none">
                <div class="loan-metric">
                    <p class="loan-metric-value">300 000,00 $</p>
                    <p class="loan-metric-label">Montant</p>
                </div>
                <div class="loan-metric">
                    <p class="loan-metric-value">180 mois</p>
                    <p class="loan-metric-label">Durée</p>
                </div>
                <div class="loan-metric">
                    <p class="loan-metric-value">1 501,87 $</p>
                    <p class="loan-metric-label">Mensualité</p>
                </div>
            </div>
            <div class="flex items-center gap-3 shrink-0">
                <span class="badge-credit badge-dot">Actif</span>
                <button
                    type="button"
                    data-loan-toggle
                    aria-expanded="false"
                    aria-controls="loan-detail-1"
                    class="w-8 h-8 rounded-lg flex items-center justify-center text-ink-3 hover:bg-canvas transition-colors"
                >
                    <span class="sr-only">Détail de la demande #NXP-2026-0142</span
                    ><svg class="w-4 h-4 transition-transform" viewBox="0 0 24 24" fill="none">
                        <path
                            d="M6 9l6 6 6-6"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </button>
            </div>
        </div>
        <div id="loan-detail-1" hidden class="mt-5 pt-5 border-t border-line">
            <dl class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-4">
                <div>
                    <dt class="text-xs font-bold text-ink-3">Taux annuel</dt>
                    <dd class="tnum text-sm font-semibold mt-1">2,15 %</dd>
                </div>
                <div>
                    <dt class="text-xs font-bold text-ink-3">Coût total du crédit</dt>
                    <dd class="tnum text-sm font-semibold mt-1">270 336,60 $</dd>
                </div>
                <div>
                    <dt class="text-xs font-bold text-ink-3">Première échéance</dt>
                    <dd class="tnum text-sm font-semibold mt-1">5 févr. 2026</dd>
                </div>
