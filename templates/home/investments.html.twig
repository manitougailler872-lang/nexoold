{% block javascripts %}
      <script type="text/javascript">  
        let currentTab = 'unique';
        function switchTab(tab){
            currentTab = tab;
            const u = document.getElementById('tab-unique'), p = document.getElementById('tab-package');
            u.classList.toggle('active', tab === 'unique');
            p.classList.toggle('active', tab === 'package');
            u.classList.toggle('text-[var(--ink-3)]', tab !== 'unique');
            p.classList.toggle('text-[var(--ink-3)]', tab !== 'package');
            document.getElementById('panel-unique').classList.toggle('hidden', tab !== 'unique');
            document.getElementById('panel-package').classList.toggle('hidden', tab !== 'package');
            updateEstimate();
        }
        function openSim(type, value){
            switchTab(type);
            const sel = type === 'unique'
            ? document.querySelector('input[name="asset"][value="'+value+'"]')
            : document.querySelector('input[name="pkg"][value="'+value+'"]');
            if (sel) sel.checked = true;
            updateEstimate();
            document.getElementById('formulaire').scrollIntoView({behavior:'smooth', block:'start'});
        }
        const fmt = n => n.toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2});
        function updateEstimate(){
            const amount = parseFloat(document.getElementById('amount').value) || 0;
            const sel = document.querySelector(currentTab === 'unique' ? 'input[name="asset"]:checked' : 'input[name="pkg"]:checked');
            if (!sel) return;

            const rate = parseFloat(sel.dataset.rate);
            const freq = parseInt(sel.dataset.freq, 10);
            const gain = amount * rate /500;
            document.getElementById('est-amount').textContent = fmt(amount) + ' €';
            document.getElementById('est-asset').textContent  = currentTab === 'unique' ? sel.value : 'Package ' + sel.value;
            document.getElementById('est-rate').textContent   = String(rate).replace('.', ',') + '%';
            document.getElementById('est-cycle').textContent  = freq + (freq === 1 ? ' jour' : ' jours');
            document.getElementById('est-gain').textContent   = fmt(gain) + ' €';
            document.getElementById('est-total').textContent  = fmt(amount + gain) + ' €';

            document.getElementById('amount-range').value = Math.min(Math.max(amount, 50), 20000);
        }
        document.getElementById('amount').addEventListener('input', updateEstimate);
        document.getElementById('amount-range').addEventListener('input', e => {
            document.getElementById('amount').value = e.target.value;
            updateEstimate();
        });
        document.querySelectorAll('input[name="asset"], input[name="pkg"]').forEach(el =>
            el.addEventListener('change', updateEstimate));

        function submitInvest(){
            const sel = document.querySelector(currentTab === 'unique' ? 'input[name="asset"]:checked' : 'input[name="pkg"]:checked');
            const amount = document.getElementById('amount').value;
            alert('Demande enregistrée : ' + (currentTab === 'unique' ? sel.value : 'Package ' + sel.value) + ' — ' + amount + ' €\n\n(Maquette front — à brancher sur CustomerController)');
        }
        function refreshPrices(){
            const icon = document.getElementById('refresh-icon');
            icon.style.transition = 'transform .6s ease';
            icon.style.transform = 'rotate(360deg)';
            setTimeout(() => { icon.style.transition = 'none'; icon.style.transform = 'rotate(0deg)'; }, 620);
            const d = new Date();
            document.getElementById('clock').textContent =
            String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0') + ':' + String(d.getSeconds()).padStart(2,'0');
        }
        updateEstimate();
</script>
{% endblock %}