{% extends 'shared/public/base.html.twig' %}
{% block body %}
    <!-- BREADCRUMB -->
    <div class="max-w-[1240px] mx-auto px-6 pt-6 text-sm text-muted fade-up" style="animation-delay: 0.23s">
        <a href="index.html" class="hover:text-green">Accueil</a> › <a href="#" class="hover:text-green">Crédits</a> ›
        <span class="text-ink">Demande de prêt Scotia<span class="text-green">Banque</span></span>
    </div>

    <!-- HERO -->
    <section class="max-w-[1240px] mx-auto px-6 pt-6 pb-10 grid lg:grid-cols-2 gap-8 items-center fade-up" style="animation-delay: 0.23s">
        <div>
            <h1 class="font-head font-bold text-4xl sm:text-5xl mb-4">
                Demande de prêt <span class="text-green">Scotia<span class="text-green">&nbsp;Banque</span></span>
            </h1>
            <p class="text-muted text-lg">
                Remplissez les informations demandées étape par étape.<br />Une réponse de principe vous sera donnée sous
                quelques minutes.
            </p>
        </div>
        <div class="hidden lg:block">
            <svg viewBox="0 0 340 220" class="w-full max-w-md ml-auto">
                <ellipse cx="200" cy="150" rx="150" ry="55" fill="#EAF6EF" />
                <!-- coins -->
                <g>
                    <ellipse cx="120" cy="150" rx="34" ry="12" fill="#7FBF97" />
                    <rect x="86" y="130" width="68" height="20" fill="#7FBF97" />
                    <ellipse cx="120" cy="130" rx="34" ry="12" fill="#A9D6BB" />
                    <ellipse cx="120" cy="128" rx="34" ry="12" fill="#3AA55C" />
                    <rect x="86" y="110" width="68" height="18" fill="#3AA55C" />
                    <ellipse cx="120" cy="110" rx="34" ry="12" fill="#5DB97E" />
                    <ellipse cx="160" cy="150" rx="30" ry="11" fill="#2E9E5B" />
                    <rect x="130" y="120" width="60" height="30" fill="#2E9E5B" />
                    <ellipse cx="160" cy="120" rx="30" ry="11" fill="#4FB374" />
                </g>
                <!-- document -->
                <g transform="rotate(6 250 90)">
                    <rect x="210" y="40" width="90" height="110" rx="8" fill="#fff" stroke="#D6E5DC" stroke-width="2" />
                    <rect x="210" y="40" width="90" height="26" rx="8" fill="#1B5E3A" />
                    <rect x="224" y="82" width="62" height="5" rx="2.5" fill="#CFE3D8" />
                    <rect x="224" y="96" width="62" height="5" rx="2.5" fill="#CFE3D8" />
                    <rect x="224" y="110" width="44" height="5" rx="2.5" fill="#CFE3D8" />
                </g>
                <!-- check -->
                <circle cx="292" cy="150" r="22" fill="#2E9E5B" />
                <path
                    d="M283 150l6 6 12-13"
                    stroke="#fff"
                    stroke-width="4"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />
            </svg>
        </div>
    </section>

    <!-- FORM WRAPPER -->
    <section class="bg-gray50 border-y border-black/5 fade-up" style="animation-delay: 0.23s">
        <div class="max-w-[1000px] mx-auto px-6 py-12">
            <!-- STEPPER -->
            <ol id="stepper" class="flex items-center justify-between mb-10 overflow-x-auto no-scrollbar text-xs gap-1">
                <li class="stp flex items-center gap-2 shrink-0" data-s="1">
                    <span class="dot"></span><span class="lbl hidden md:inline">Informations personnelles</span>
                </li>
                <li class="flex-1 h-px bg-black/10 mx-1 min-w-[10px]"></li>
                <li class="stp flex items-center gap-2 shrink-0" data-s="2">
                    <span class="dot"></span><span class="lbl hidden md:inline">Adresse</span>
                </li>
                <li class="flex-1 h-px bg-black/10 mx-1 min-w-[10px]"></li>
                <li class="stp flex items-center gap-2 shrink-0" data-s="3">
                    <span class="dot"></span><span class="lbl hidden md:inline">Détails de la demande</span>
                </li>
                <li class="flex-1 h-px bg-black/10 mx-1 min-w-[10px]"></li>
                <li class="stp flex items-center gap-2 shrink-0" data-s="4">
                    <span class="dot"></span><span class="lbl hidden md:inline">Situation professionnelle</span>
                </li>
                <li class="flex-1 h-px bg-black/10 mx-1 min-w-[10px]"></li>
                <li class="stp flex items-center gap-2 shrink-0" data-s="5">
                    <span class="dot"></span><span class="lbl hidden md:inline">Projet</span>
                </li>
                <li class="flex-1 h-px bg-black/10 mx-1 min-w-[10px]"></li>
                <li class="stp flex items-center gap-2 shrink-0" data-s="6">
                    <span class="dot"></span><span class="lbl hidden md:inline">Récapitulatif</span>
                </li>
            </ol>

            <div class="space-y-3" id="accordion"></div>

            <!-- warning -->
            <div class="flex gap-3 bg-white border border-black/8 rounded-xl p-4 mt-6 text-sm">
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#6B7280"
                    stroke-width="2"
                    class="shrink-0 mt-0.5"
                >
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 16v-4M12 8h.01" />
                </svg>
                <p>
                    <span class="font-semibold">Un crédit vous engage et doit être remboursé.</span>
                    <span class="text-muted">Vérifiez vos capacités de remboursement avant de vous engager.</span>
                </p>
            </div>

            <!-- secure footer card -->
            <div class="bg-white border border-black/8 rounded-xl p-6 mt-4 flex flex-col md:flex-row items-center gap-6">
                <div class="flex items-center gap-4 flex-1">
                    <span class="w-14 h-14 rounded-full bg-mint flex items-center justify-center text-green shrink-0"
                        ><svg
                            width="26"
                            height="26"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                        >
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            <path d="m9 12 2 2 4-4" /></svg
                    ></span>
                    <div>
                        <p class="font-bold">Vos données sont sécurisées</p>
                        <p class="text-muted text-sm">
                            Toutes les informations que vous fournissez sont cryptées et traitées en toute confidentialité.
                        </p>
                    </div>
                </div>
                <div class="text-center">
                    <button
                        onclick="nextFromSecure()"
                        class="bg-green-deep text-white font-semibold px-10 py-3.5 rounded-lg hover:bg-green transition-colors flex items-center gap-2 justify-center w-full"
                    >
                        Suivant
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M13 6l6 6-6 6" />
                        </svg>
                    </button>
                    <p class="text-xs text-muted mt-2 flex items-center gap-1 justify-center">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="5" y="11" width="14" height="10" rx="2" />
                            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                        </svg>
                        Réponse sous quelques minutes
                    </p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}